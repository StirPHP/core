expression: "render(&[\"\", \"# only a comment\", \"null\", \"NULL\", \"true\", \"yes\", \"On\", \"off\",\n\"No\", \"FALSE\", \"123\", \"-123\", \"+5\", \"1.5\", \"-1.5e3\", \".5\", \"1e3\", \"0x1F\",\n\"0o17\", \"0b101\", \"0777\", \"99999999999999999999\", \"hello\", \"hello world\",\n\"hello  # comment\", \"foo#bar\", \"a:b\", \"http://example.com/path?x=1\",\n\"%currentWorkingDirectory%/src\", \"*/tests/*\", \"@service\", \"2024-01-15\",\n\"2024-01-15 10:20:30\", \"-foo\", \"::bar\", \"'single'\", \"'it''s'\",\n\"\\\"double\\\\n\\\\t\\\\\\\"q\\\\\\\" \\\\u00e9 \\\\x41 \\\\uD83D\\\\uDE00 \\\\/ \\\\_\\\"\",\n\"'no \\\\n escapes'\", \"\\\"bad \\\\q escape\\\"\", \"'unterminated\",])"
---
""
  => null
"# only a comment"
  => null
"null"
  => null
