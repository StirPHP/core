---
source: crates/stir_neon/tests/syntax.rs
expression: "render(&[\"a: 1\\nb: 2\", \"a: 1\\nb:\\nc: 3\", \"a:\\n  b: 1\\n  c:\\n    d: 2\\ne: 3\",\n\"- a\\n- b\\n- c\", \"list:\\n  - a\\n  - b\", \"list:\\n- a\\n- b\\nnext: 1\",\n\"- a: 1\\n  b: 2\\n- c: 3\", \"- - a\\n  - b\\n- c\", \"-\\n  a: 1\", \"- \\n- x\",\n\"key: [1, 2]\\nother: {a: b}\", \"a: 1 # comment\\n# full line comment\\n\\nb: 2\",\n\"  indented: 1\\n  same: 2\", \"a=1\\nb=2\", \"a: 1\\n  b: 2\", \"a:\\n  b: 1\\n c: 2\",\n\"a:\\n\\tb: 1\\n  c: 2\", \"a: 1 2\", \"a: 1\\nb\", \"a: 1\\na: 2\",\n\"x: hello world\\ny: 'quoted' \", \"- 1\\n-2\",\n\"empty:\\n  # comment only\\nnext: 1\", \"a: ]\",])"
---
"a: 1\nb: 2"
  => {"a": 1, "b": 2}
"a: 1\nb:\nc: 3"
  => {"a": 1, "b": null, "c": 3}
"a:\n  b: 1\n  c:\n    d: 2\ne: 3"
  => {"a": {"b": 1, "c": {"d": 2}}, "e": 3}
"- a\n- b\n- c"
  => ["a", "b", "c"]
"list:\n  - a\n  - b"
  => {"list": ["a", "b"]}
"list:\n- a\n- b\nnext: 1"
  => {"list": ["a", "b"], "next": 1}
"- a: 1\n  b: 2\n- c: 3"
  => [{"a": 1, "b": 2}, {"c": 3}]
"- - a\n  - b\n- c"
  => [["a", "b"], "c"]
"-\n  a: 1"
  => [{"a": 1}]
"- \n- x"
  => [null, "x"]
"key: [1, 2]\nother: {a: b}"
  => {"key": [1, 2], "other": {"a": "b"}}
"a: 1 # comment\n# full line comment\n\nb: 2"
  => {"a": 1, "b": 2}
"  indented: 1\n  same: 2"
  => {"indented": 1, "same": 2}
"a=1\nb=2"
  => {"a": 1, "b": 2}
"a: 1\n  b: 2"
  => ERROR: Bad indentation on line 2 at column 3
"a:\n  b: 1\n c: 2"
  => ERROR: Bad indentation on line 3 at column 2
"a:\n\tb: 1\n  c: 2"
  => ERROR: Invalid combination of tabs and spaces on line 3 at column 3
"a: 1 2"
  => {"a": "1 2"}
"a: 1\nb"
  => ERROR: Unexpected end on line 2 at column 2
"a: 1\na: 2"
  => ERROR: Duplicated key 'a' on line 2 at column 1
"x: hello world\ny: 'quoted' "
  => {"x": "hello world", "y": "quoted"}
"- 1\n-2"
  => ERROR: Unexpected end on line 2 at column 3
"empty:\n  # comment only\nnext: 1"
  => {"empty": null, "next": 1}
"a: ]"
  => ERROR: Unexpected ']' on line 1 at column 4
