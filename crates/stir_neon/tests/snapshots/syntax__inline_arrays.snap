---
source: crates/stir_neon/tests/syntax.rs
expression: "render(&[\"[]\", \"{}\", \"()\", \"[1, 2, 3]\", \"[1, 2, 3,]\", \"{a: 1, b: 2}\",\n\"{a=1, b=2}\", \"[a, b: c, d]\", \"{1: a, b}\", \"{0: a, 1: b}\",\n\"[\\n  1\\n  2\\n  3\\n]\", \"{\\n  a: 1,\\n  b: [x, y]\\n}\", \"[a: ]\", \"{a: 1, a: 2}\",\n\"{true: 1, null: 2, 123: x, '456': y, 1.5: z}\", \"[1 2]\", \"[1, 2\",\n\"{[a]: b}\",])"
---
"[]"
  => []
"{}"
  => {}
"()"
  => []
"[1, 2, 3]"
  => [1, 2, 3]
"[1, 2, 3,]"
  => [1, 2, 3]
"{a: 1, b: 2}"
  => {"a": 1, "b": 2}
"{a=1, b=2}"
  => {"a": 1, "b": 2}
"[a, b: c, d]"
  => {0: "a", "b": "c", 1: "d"}
"{1: a, b}"
  => {1: "a", 2: "b"}
"{0: a, 1: b}"
  => ["a", "b"]
"[\n  1\n  2\n  3\n]"
  => [1, 2, 3]
"{\n  a: 1,\n  b: [x, y]\n}"
  => {"a": 1, "b": ["x", "y"]}
"[a: ]"
  => {"a": null}
"{a: 1, a: 2}"
  => ERROR: Duplicated key 'a' on line 1 at column 8
"{true: 1, null: 2, 123: x, '456': y, 1.5: z}"
  => {"true": 1, "null": 2, 123: "x", 456: "y", "1.5": "z"}
"[1 2]"
  => ["1 2"]
"[1, 2"
  => ERROR: Unexpected end on line 1 at column 6
"{[a]: b}"
  => ERROR: Unacceptable key on line 1 at column 2
