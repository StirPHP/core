/**
 * A base class plain PHP extends.
 *
 * @since 1.0
 */
open class Base {
    /** The name, as a subclass may redeclare it. */
    protected var $name: string = "base"
    public var $count: int = 0

    /**
     * Describes it.
     *
     * @param string $suffix What to append.
     * @return string The description.
     */
    open function describe(suffix: string): string = $this->name . suffix
}

abstract class Shape {
    abstract function area(): float
    function twice(): float = $this->area() * 2
}

interface Named {
    function label(): string
}

// Untyped PHP subclasses: each of these is a fatal if the parent declares native types.
eval('class Sub extends Base { protected $name = "sub"; public $count = "many"; public function describe($suffix) { return parent::describe($suffix) . "!"; } }');
eval('class Square extends Shape { public function area() { return 4.0; } }');
eval('class Tag implements Named { public function label() { return "tag"; } }');

val sub = call_user_func([new ReflectionClass("Sub"), "newInstance"]) as Base
echo sub->describe("?") . "\n"
val square = call_user_func([new ReflectionClass("Square"), "newInstance"]) as Shape
echo "${square->twice()}\n"
val tag = call_user_func([new ReflectionClass("Tag"), "newInstance"]) as Named
echo tag->label() . "\n"
echo if (str_contains(strval(new ReflectionClass("Base")->getDocComment()), "plain PHP extends")) "class doc kept\n" else "class doc lost\n"
echo if (str_contains(strval(new ReflectionMethod("Base", "describe")->getDocComment()), "What to append")) "method doc kept\n" else "method doc lost\n"
