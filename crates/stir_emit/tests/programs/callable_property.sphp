class Holder {
    private var $callback: callable? = null

    function set(callback: callable): Unit {
        $this->callback = callback
    }

    function run(): int {
        val callback = $this->callback
        if (callback === null) {
            return 0
        }
        return call_user_func(callback) as int
    }
}

val holder = new Holder()
echo "${holder->run()}\n"
holder->set("time")
echo if (holder->run() > 0) "called\n" else "not called\n"

class Promoted(private val callback: callable) {
    function run(): int = call_user_func($this->callback) as int
}

echo if (new Promoted("time")->run() > 0) "called\n" else "not called\n"
