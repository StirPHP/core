namespace App

interface Shape {
    function area(): Float
    function name(): String
}

open class Base(val id: Int) {
    function describe(): String = "base ${id}"
}

class User(id: Int, var $name: String) : Base(id) {
    val created: Int = 7
    function rename(to: String): Unit {
        $name = to
    }
    function label(): String = "${name}#${id}@${created}"
}

class Circle(val r: Float) : Shape {
    function area(): Float = 3.0 * r * r
    function name(): String = "circle"
}

data class Point(val x: Int, val y: Int)

val u = new User(1, "ann")
u->rename("bob")
echo u->label() . "\n"
echo u->describe() . "\n"
val c: Shape = new Circle(2.0)
echo "${c->name()} ${c->area()}\n"
val p = new Point(3, 4)
echo "${p->x},${p->y}\n"
