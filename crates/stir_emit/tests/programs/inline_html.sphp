/**
 * Title: A pattern
 * Slug: demo/pattern
 */

function title(): String = "Hi"

function maybe(v: List<String?>): Int = v->size()
?>
<h1><?php echo title(); ?></h1>
<p><?= strlen("abc") ?></p>
<?php foreach (listOf("a", "b") as $x): ?>
<i><?php echo $x ?></i>
<?php endforeach; ?>
<?php if (maybe(listOf(null)) === 1): ?>
one
<?php endif; ?>
<?php echo if (strpos(file_get_contents(__FILE__) as String, "Slug: demo/pattern") !== false) "header kept\n" else "header lost\n"
