function pick(a: Int, f: (Int) -> Int): Int = f(a)

echo "${pick(1, { x: Int ->
    if (x > 5) {
        return 10
    }
    return 20
})}\n"

echo "${pick(7, { x: Int ->
    val y = x + 1
    if (y > 5) y * 2 else y
})}\n"

echo "${pick(1, { x: Int ->
    val y = x + 1
    if (y > 5) {
        y * 2
    } else if (y > 1) {
        y * 3
    } else {
        y
    }
})}\n"

function &shared(): array {
    static $values = []
    return $values
}

class Box {
    private var $items: array<int> = []
    function &items(): array<int> {
        return $this->items
    }
    function size(): int = count($this->items)
}

val box = new Box()
echo if (new ReflectionFunction("shared")->returnsReference()) "by ref\n" else "by value\n"
echo if (new ReflectionMethod("Box", "items")->returnsReference()) "by ref\n" else "by value\n"
