namespace App

enum Suit: string {
    case Hearts = "H"
    case Spades = "S"
}

class Counter {
    var $n: Int = 0
    function inc(): Counter {
        $n += 1
        return $this
    }
    static function make(): Counter = new Counter()
}

var $items = mutableListOf<Int>()
$items->add(3)
$items->add(1)
$items->add(2)
echo "size=${items->size()}\n"

val ages = mapOf("ann" to 31, "bob" to 25)
foreach (ages as $name => $age) {
    echo "${name}:${age}\n"
}
val missing = ages["zed"] ?: -1
echo "missing=${missing}\n"

val c = Counter::make()->inc()->inc()
echo "counter=${c->n}\n"

function classify(x: Int): Unit {
    when {
        x < 0 -> echo "neg\n"
        x == 0 -> echo "zero\n"
        else -> echo "pos\n"
    }
}
classify(-5)
classify(0)
classify(9)

function risky(x: Int): Int {
    if (x > 2) {
        throw new \InvalidArgumentException("too big: ${x}")
    }
    return x * 10
}

try {
    echo "${risky(1)}\n"
    echo "${risky(5)}\n"
} catch (\InvalidArgumentException $e) {
    echo "caught ${e->getMessage()}\n"
}

echo "${Suit::Hearts->value}\n"

val maybe: String? = null
val len = maybe?->length() ?: 0
echo "len=${len}\n"
val word: String? = "héllo"
echo "len2=${word?->length() ?: 0}\n"
