<?php

declare(strict_types=1);

$values = [1, 2, 3];
foreach ($values as $k => &$x) {
    $x = $x * 2;
}
echo \implode(',', $values) . "\n";

function doubled(array &$v): void
{
    foreach ($v as &$x) {
        $x = 0;
    }
}

$a = [1, 2];
\doubled($a);
echo \implode(',', $a) . "\n";
