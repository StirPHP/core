/**
 * A user.
 *
 * @template T of object
 */
#[Entity(table: 'users')]
final class User extends \App\Model implements \JsonSerializable, Countable
{
    use HasId, HasName;
    use A, B {
        A::hello insteadof B;
        B::hello as protected bHello;
        bye as private;
    }

    public const string TABLE = 'users';
    final protected const MAX = 10;
    const UNTYPED = null;

    private static int $count = 0;
    public ?string $email = null;
    protected $untyped;

    /** @var list<string> */
    public readonly array $list;

    public function __construct(
        private readonly int $id,
        public string $name,
        public private(set) array $tags = [],
        bool $plain = false,
    ) {
    }

    public static function create(): static
    {
        return new static(1, 'x');
    }

    final public function count(): int
    {
        return 1;
    }

    public function jsonSerialize(): mixed
    {
        return $this->email;
    }

    protected function &ref(): array
    {
        return self::$arr;
    }

    private static array $arr = [];
}

abstract class Shape
{
    abstract public function area(): float;

    abstract protected static function name($x): string;
}

