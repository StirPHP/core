<?php

declare(strict_types=1);

namespace App;

enum Suit: string
{
    case Hearts = 'H';
    case Spades = 'S';
}

final class Counter
{
    public int $n = 0;

    public function inc(): \App\Counter
    {
        $this->n += 1;
        return $this;
    }

    public static function make(): \App\Counter
    {
        return new \App\Counter();
    }
}

$items = [];
\array_push($items, 3);
\array_push($items, 1);
\array_push($items, 2);
echo 'size=' . \count($items) . "\n";
$ages = ['ann' => 31, 'bob' => 25];
foreach ($ages as $name => $age) {
    echo "{$name}:{$age}\n";
}
$missing = $ages['zed'] ?? -1;
echo "missing={$missing}\n";
$c = \App\Counter::make()->inc()->inc();
echo "counter={$c->n}\n";

function classify(int $x): void
{
    if ($x < 0) {
        echo "neg\n";
    } elseif ($x === 0) {
        echo "zero\n";
    } else {
        echo "pos\n";
    }
}

\App\classify(-5);
\App\classify(0);
\App\classify(9);

function risky(int $x): int
{
    if ($x > 2) {
        throw new \InvalidArgumentException("too big: {$x}");
    }
    return $x * 10;
}

try {
    echo \App\risky(1) . "\n";
    echo \App\risky(5) . "\n";
} catch (\InvalidArgumentException $e) {
    echo "caught {$e->getMessage()}\n";
}
echo \App\Suit::Hearts->value . "\n";
$maybe = null;
$len = ($maybe === null ? null : \mb_strlen($maybe)) ?? 0;
echo "len={$len}\n";
$word = 'héllo';
echo 'len2=' . (($word === null ? null : \mb_strlen($word)) ?? 0) . "\n";
