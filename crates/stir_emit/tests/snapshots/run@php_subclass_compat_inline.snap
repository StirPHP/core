<?php

declare(strict_types=1);

/**
 * A base class plain PHP extends.
 *
 * @since 1.0
 */
class Base
{
    /**
     * The name, as a subclass may redeclare it.
     *
     * @var string
     */
    protected $name = 'base';

    /** @var int */
    public $count = 0;

    /**
     * Describes it.
     *
     * @param string $suffix What to append.
     *
     * @return string
     */
    public function describe(string $suffix)
    {
        return $this->name . $suffix;
    }
}

abstract class Shape
{
    /** @return float */
    abstract public function area();

    final public function twice(): float
    {
        return $this->area() * 2;
    }
}

interface Named
{
    /** @return string */
    public function label();
}

eval('class Sub extends Base { protected $name = "sub"; public $count = "many"; public function describe($suffix) { return parent::describe($suffix) . "!"; } }');
eval('class Square extends Shape { public function area() { return 4.0; } }');
eval('class Tag implements Named { public function label() { return "tag"; } }');
$__c1 = \call_user_func([new \ReflectionClass('Sub'), 'newInstance']);
$sub = $__c1 instanceof \Base ? $__c1 : throw new \TypeError('cast to \\Base failed');
echo $sub->describe('?') . "\n";
$__c2 = \call_user_func([new \ReflectionClass('Square'), 'newInstance']);
$square = $__c2 instanceof \Shape ? $__c2 : throw new \TypeError('cast to \\Shape failed');
echo "{$square->twice()}\n";
$__c3 = \call_user_func([new \ReflectionClass('Tag'), 'newInstance']);
$tag = $__c3 instanceof \Named ? $__c3 : throw new \TypeError('cast to \\Named failed');
echo $tag->label() . "\n";
echo \str_contains(\strval((new \ReflectionClass('Base'))->getDocComment()), 'plain PHP extends') ? "class doc kept\n" : "class doc lost\n";
echo \str_contains(
    \strval((new \ReflectionMethod('Base', 'describe'))->getDocComment()),
    'What to append',
) ? "method doc kept\n" : "method doc lost\n";
