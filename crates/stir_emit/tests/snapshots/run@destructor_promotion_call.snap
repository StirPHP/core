<?php

declare(strict_types=1);

final class Promoted
{
    public function __construct(
        public int $b,
        private readonly string $c = 'c',
    ) {
    }

    public function c(): string
    {
        return $this->c;
    }

    public function __destruct()
    {
        echo "destroyed\n";
    }
}

function f(): void
{
    $p = new \Promoted(1);
    echo "{$p->b} {$p->c()}\n";
}

\f();

function jumps(int $n): int
{
    if ($n > 2) {
        goto done;
    }
    echo "small\n";
    done:
    return $n;
}

echo \jumps(1) . "\n";
echo \jumps(3) . "\n";
