<?php

declare(strict_types=1);

namespace App;

interface Shape
{
    public function area(): float;

    public function name(): string;
}

class Base
{
    public function __construct(
        public readonly int $id,
    ) {
    }

    public function describe(): string
    {
        return "base {$this->id}";
    }
}

final class User extends \App\Base
{
    public function __construct(
        int $id,
        public string $name,
    ) {
        parent::__construct($id);
        $this->created = 7;
    }

    public readonly int $created;

    public function rename(string $to): void
    {
        $this->name = $to;
    }

    public function label(): string
    {
        return "{$this->name}#{$this->id}@{$this->created}";
    }
}

final class Circle implements \App\Shape
{
    public function __construct(
        public readonly float $r,
    ) {
    }

    public function area(): float
    {
        return 3.0 * $this->r * $this->r;
    }

    public function name(): string
    {
        return 'circle';
    }
}

final readonly class Point
{
    public function __construct(
        public int $x,
        public int $y,
    ) {
    }
}

$u = new \App\User(1, 'ann');
$u->rename('bob');
echo $u->label() . "\n";
echo $u->describe() . "\n";
$c = new \App\Circle(2.0);
echo "{$c->name()} {$c->area()}\n";
$p = new \App\Point(3, 4);
echo "{$p->x},{$p->y}\n";
