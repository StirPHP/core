<?php

declare(strict_types=1);

require_once __DIR__ . '/stir-runtime.php';
$a = 7;
$b = 2;
echo $a / $b . "\n";
echo 6 / 2 . "\n";
echo \ceil($a / $b) . "\n";
echo \ceil(\intval('7') / \intval('2')) . "\n";
echo \Stir\Int_div($a, $b) . "\n";
$n = 9;
$n /= 2;
echo "{$n}\n";
