---
source: crates/stir_emit/tests/exprs.rs
expression: "expr_cases(vec![(\"var\", v(\"x\")), (\"weird var name\", v(\"not an ident\")),\n(\"var var\", Expr::new(ExprKind::VarVar(Box::new(v(\"name\"))))),\n(\"var var expr\",\nExpr::new(ExprKind::VarVar(Box::new(s(\"a\").concat(v(\"b\")))))),\n(\"prop\", v(\"o\").prop(\"p\")), (\"nullsafe prop\", v(\"o\").nullsafe_prop(\"p\")),\n(\"dynamic prop\", v(\"o\").prop(v(\"name\"))),\n(\"dynamic prop expr\", v(\"o\").prop(s(\"a\").concat(v(\"b\")))),\n(\"static prop\", Expr::static_prop(\"Foo\", \"count\")),\n(\"static prop self\", Expr::static_prop(\"self\", \"count\")),\n(\"static prop dynamic\", Expr::static_prop(\"static\", v(\"n\"))),\n(\"class const\", Expr::class_const(\"\\\\Foo\\\\Bar\", \"BAZ\")),\n(\"class const dynamic\", Expr::class_const(\"Foo\", v(\"c\"))),\n(\"class name\", Expr::class_name(\"parent\")), (\"index\", v(\"a\").index(s(\"k\"))),\n(\"nested index\", v(\"a\").index(int(0)).index(v(\"i\").add(int(1)))),\n(\"push\", v(\"a\").push_index().assign(int(1))),\n(\"this\", Expr::this().prop(\"x\")),])"
---
<?php

declare(strict_types=1);

// var
$x;
// weird var name
${'not an ident'};
// var var
$$name;
// var var expr
${'a' . $b};
// prop
$o->p;
// nullsafe prop
$o?->p;
// dynamic prop
$o->{$name};
// dynamic prop expr
$o->{'a' . $b};
// static prop
Foo::$count;
// static prop self
self::$count;
// static prop dynamic
static::${$n};
// class const
\Foo\Bar::BAZ;
// class const dynamic
Foo::{$c};
// class name
parent::class;
// index
$a['k'];
// nested index
$a[0][$i + 1];
// push
$a[] = 1;
// this
$this->x;
