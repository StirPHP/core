---
<?php

declare(strict_types=1);

// fits
f($argumentNumber0, $argumentNumber1, $argumentNumber2);
// too long: one per line with trailing comma
someFunction(
    $argumentNumber0,
    $argumentNumber1,
    $argumentNumber2,
    $argumentNumber3,
    $argumentNumber4,
    $argumentNumber5,
);
// nested call breaks only where needed
$result = outer(
    inner($argumentNumber0, $argumentNumber1, $argumentNumber2, $argumentNumber3, $argumentNumber4),
    1,
);
// arrays
$config = [
    'short' => [1, 2],
    'long' => [
        'key_0' => 'value number 0',
        'key_1' => 'value number 1',
        'key_2' => 'value number 2',
        'key_3' => 'value number 3',
        'key_4' => 'value number 4',
        'key_5' => 'value number 5',
        'key_6' => 'value number 6',
        'key_7' => 'value number 7',
    ],
];
// closure argument stays inline
$ys = array_map(function ($x) use ($factor) {
    return $x * $factor;
}, $xs);
// isset / unset
if (isset(
    $argumentNumber0,
    $argumentNumber1,
    $argumentNumber2,
    $argumentNumber3,
    $argumentNumber4,
    $argumentNumber5,
)) {
    unset(
        $argumentNumber0,
        $argumentNumber1,
        $argumentNumber2,
        $argumentNumber3,
        $argumentNumber4,
        $argumentNumber5,
    );
}
// new and method args
$x = new \Very\Long\Namespace\ClassName(
    $argumentNumber0,
    $argumentNumber1,
    $argumentNumber2,
    $argumentNumber3,
);
$this->doSomethingWith(
    $argumentNumber0,
    $argumentNumber1,
    $argumentNumber2,
    $argumentNumber3,
    $argumentNumber4,
);

function aFunctionWithAVeryLongName(
    \Some\Namespaced\ClassName $firstParameter,
    ?string $secondParameter = null,
): \Some\Namespaced\ReturnType {
    return new \Some\Namespaced\ReturnType();
}

class K
{
    public function aMethodWithAVeryLongNameIndeed(
        \Some\Namespaced\ClassName $firstParameter,
        string $secondParameter,
    ): void {
    }
}
