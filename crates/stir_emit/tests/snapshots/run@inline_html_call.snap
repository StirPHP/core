<?php

/**
 * Title: A pattern
 * Slug: demo/pattern
 */

declare(strict_types=1);

require_once __DIR__ . '/stir-runtime.php';

function title(): string
{
    return 'Hi';
}

/** @param list<?string> $v */
function maybe(array $v): int
{
    return \Stir\List_size($v);
}

?><h1><?php
echo \title();
?></h1>
<p><?php
echo \strlen('abc');
?></p>
<?php
foreach (['a', 'b'] as $x) {
    ?><i><?php
    echo $x;
    ?></i>
<?php
}
if (\maybe([null]) === 1) {
    ?>one
<?php
}
$__c1 = \file_get_contents(__FILE__);
echo \strpos(
    \is_string($__c1) ? $__c1 : throw new \TypeError('cast to string failed'),
    'Slug: demo/pattern',
) !== false ? "header kept\n" : "header lost\n";
