<?php

declare(strict_types=1);

function noop()
{
}

/**
 * Adds things.
 *
 * @param list<int> $xs
 * @return int
 */
#[\Deprecated, Pure()]
function &sum(
    array $xs,
    int $start = 0,
    &$out = null,
    #[\SensitiveParameter] string $secret = '',
    int ...$rest,
): int {
    return array_sum($xs) + $start;
}

