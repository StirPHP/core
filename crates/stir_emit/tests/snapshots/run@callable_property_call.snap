<?php

declare(strict_types=1);

final class Holder
{
    /** @var ?callable */
    private $callback = null;

    public function set(callable $callback): void
    {
        $this->callback = $callback;
    }

    public function run(): int
    {
        $callback = $this->callback;
        if ($callback === null) {
            return 0;
        }
        $__c1 = \call_user_func($callback);
        return \is_int($__c1) ? $__c1 : throw new \TypeError('cast to int failed');
    }
}

$holder = new \Holder();
echo "{$holder->run()}\n";
$holder->set('time');
echo $holder->run() > 0 ? "called\n" : "not called\n";

final class Promoted
{
    public function __construct(
        private readonly mixed $callback,
    ) {
    }

    public function run(): int
    {
        $__c2 = \call_user_func($this->callback);
        return \is_int($__c2) ? $__c2 : throw new \TypeError('cast to int failed');
    }
}

echo (new \Promoted('time'))->run() > 0 ? "called\n" : "not called\n";
