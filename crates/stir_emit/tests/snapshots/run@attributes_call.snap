<?php

declare(strict_types=1);

#[AllowDynamicProperties]
final class Bag
{
    #[Deprecated]
    public function old(): void
    {
    }
}

#[Deprecated(message: 'gone')]
function legacy(): void
{
}

foreach ((new \ReflectionClass('Bag'))->getAttributes() as $attribute) {
    echo $attribute->getName() . "\n";
}
foreach ((new \ReflectionMethod('Bag', 'old'))->getAttributes() as $attribute) {
    echo $attribute->getName() . "\n";
}
foreach ((new \ReflectionFunction('legacy'))->getAttributes() as $attribute) {
    echo $attribute->getName() . "\n";
}
