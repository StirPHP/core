<?php

declare(strict_types=1);

namespace App;

function greet(string $name): string
{
    return "Hello, {$name}";
}

class Counter
{
    private int $n = 0;

    public function inc(): int
    {
        return ++$this->n;
    }
}

echo greet('wörld');

