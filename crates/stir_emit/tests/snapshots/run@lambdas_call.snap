<?php

declare(strict_types=1);

namespace App;

require_once __DIR__ . '/stir-runtime.php';
$nums = \Stir\listOf(1, 2, 3, 4);
$doubled = \Stir\List_map($nums, fn (int $it): int => $it * 2);
echo \Stir\List_joinToString($doubled, ',') . "\n";
$evens = \Stir\List_map(
    \Stir\List_filter($nums, fn (int $it): bool => $it % 2 === 0),
    fn (int $x): string => "n{$x}",
);
echo \Stir\List_joinToString($evens, ' ') . "\n";
$count = 0;
\Stir\List_forEach($nums, function (int $it) use (&$count): void {
    $count += $it;
});
echo "sum={$count}\n";
$total = \Stir\List_fold($nums, 0, fn (int $acc, int $x): int => $acc + $x);
echo "fold={$total}\n";
$s = '  hi  ';
echo '[' . \Stir\String_uppercase(\Stir\String_trim($s)) . "]\n";
$kind = match (true) {
    $total > 5 => 'big',
    default => 'small',
};
echo $kind . "\n";
$add = fn (int $a, int $b): int => $a + $b;
echo "add={$add(2, 3)}\n";
