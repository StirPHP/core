source: crates/stir_emit/tests/exprs.rs
expression: "file(vec![Stmt::comment(\"closure\"),\nv(\"f\").assign(Expr::closure(closure)).stmt(),\nStmt::comment(\"static by-ref closure\"),\nv(\"g\").assign(Expr::closure(static_ref)).stmt(),\nStmt::comment(\"empty closure\"),\nv(\"h\").assign(Expr::closure(Closure::default())).stmt(),\nStmt::comment(\"arrow fn\"), v(\"k\").assign(Expr::new(arrow)).stmt(),\nStmt::comment(\"match\"), v(\"r\").assign(m).stmt(),\nv(\"r\").assign(match_true).stmt(), Stmt::comment(\"closure as argument\"),\nExpr::call_fn(\"usort\",\nargs(vec![v(\"xs\"),\nExpr::closure(Closure::new(vec![Param::new(\"a\"), Param::new(\"b\")],\nvec![Stmt::ret(Some(bin(BinaryOp::Spaceship, v(\"a\"), v(\"b\"))))],))])).stmt(),\nStmt::comment(\"generator\"), in_function(\"gen\", gen_body),])"
---
<?php

declare(strict_types=1);

// closure
$f = function (int $x) use ($y, &$acc): void {
    $acc[] = $x + $y;
};
// static by-ref closure
$g = #[Pure] static function &() {
    return $this_is_fine;
};
// empty closure
$h = function () {};
// arrow fn
$k = static fn &(?int $x = null): int => $x ?? 0;
// match
$r = match ($x) {
    1, 2 => 'low',
    3 => 'mid',
    default => throw new \LogicException(),
};
$r = match (true) {
    $x instanceof A => 1,
    $x->n > 1 => $a ? 1 : 2,
};
// closure as argument
usort($xs, function ($a, $b) {
    return $a <=> $b;
});

// generator
function gen()
{
    yield;
    yield 1;
    yield 'k' => $v;
    $got = yield $v;
    yield from other();
}
