source: crates/stir_emit/tests/precedence.rs
expression: expr_cases(out)
---
<?php

declare(strict_types=1);

// mul of add
($a + $b) * $c;
// pow neg
(-$a) ** 2;
// neg pow
-$a ** 2;
// concat add
'x' . $a + $b;
// add concat
('1' . $a) + $b;
// not instanceof
!$a instanceof B;
// instanceof not
(!$a) instanceof B;
// neg neg
- -1;
// coalesce
($a ?? $b) ?? $c;
// ternaries
($a ? 1 : 2) ? 3 : ($b ? 4 : 5);
// new deref
$x = (new ArrayObject())->count();
// clone deref
$x = (clone new ArrayObject())->count();
// assign in cond
!($a && ($b = 1));
// print operand
(print $a) + 1;
// include operand
(include_once 'a.php') . 'x';
// throw operand
$x = $a ?? throw new \Exception();
// casts
(int) $a + (float) ($b + $c);
// closure call
$x = (function () {})();
// list
[$a, , $b] = $arr;
// pow chain
$x = (2 ** 3) ** 2;
// shift concat
$x = ('1' . '2') << 1;
