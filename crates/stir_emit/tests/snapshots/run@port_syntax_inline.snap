<?php

declare(strict_types=1);

$total = 0;
for ($i = 0; $i < 3; $i++) {
    $total += $i;
}
echo "{$total}\n";

function pick(int $a): int
{
    return $a > 1 ? 10 : ($a > 0 ? 20 : 30);
}

echo \pick(2) . ' ' . \pick(1) . ' ' . \pick(0) . "\n";
$b = true;
$x = $b ? 'yes' : 'no';
echo $x . "\n";
$f = fn (int|string $a): string => 'got';
echo $f(1) . "\n";
echo 'a' < 'b' ? "ordered\n" : "unordered\n";

final class R1
{
    public function a(): int
    {
        return 1;
    }

    public int $p = 10;
}

final class R2
{
    public function a(): int
    {
        return 2;
    }

    public int $p = 20;
}

function shared(\R1|\R2 $x): int
{
    return $x->a() + $x->p;
}

echo \shared(new \R1()) . ' ' . \shared(new \R2()) . "\n";

final class Counts
{
    /** @var array<int> */
    private array $s = [1, 2];

    public function count(): int
    {
        return \count($this->s);
    }

    public function twice(): int
    {
        return $this->count() * 2;
    }
}

echo (new \Counts())->twice() . "\n";

function push(array &$x, int $n): void
{
    $x[] = $n;
}

$list = [];
\push($list, 5);
echo \count($list) . "\n";
$anything = [1, 2];
$__c1 = $anything;
foreach (\is_array($__c1) ? $__c1 : throw new \TypeError('cast to array failed') as $v) {
    echo \strval($v) . "\n";
}
