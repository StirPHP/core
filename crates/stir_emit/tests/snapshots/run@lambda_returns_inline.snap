<?php

declare(strict_types=1);

/** @param \Closure(int): int $f */
function pick(int $a, \Closure $f): int
{
    return $f($a);
}

echo \pick(1, function (int $x): int {
    if ($x > 5) {
        return 10;
    }
    return 20;
}) . "\n";
echo \pick(7, function (int $x): int {
    $y = $x + 1;
    if ($y > 5) {
        return $y * 2;
    } else {
        return $y;
    }
}) . "\n";
echo \pick(1, function (int $x): int {
    $y = $x + 1;
    if ($y > 5) {
        return $y * 2;
    } elseif ($y > 1) {
        return $y * 3;
    } else {
        return $y;
    }
}) . "\n";

function &shared(): array
{
    static $values = [];
    return $values;
}

final class Box
{
    /** @var array<int> */
    private array $items = [];

    /** @return array<int> */
    public function &items(): array
    {
        return $this->items;
    }

    public function size(): int
    {
        return \count($this->items);
    }
}

$box = new \Box();
echo (new \ReflectionFunction('shared'))->returnsReference() ? "by ref\n" : "by value\n";
echo (new \ReflectionMethod('Box', 'items'))->returnsReference() ? "by ref\n" : "by value\n";
