expression: out.code
---
<?php

declare(strict_types=1);

final class Holder
{
    public mixed $value = null;

    public function get(): mixed
    {
        return $this->value;
    }
}

function describe(mixed $v): string
{
    if (\is_string($v)) {
        return "string {$v}";
    }
    if (\is_int($v)) {
        return 'int ' . \strval($v);
    }
    if ($v === null) {
        return 'null';
    }
    return 'other';
}

echo \describe('a') . "\n";
echo \describe(1) . "\n";
echo \describe(null) . "\n";
echo \describe([1]) . "\n";
echo \describe(1.5) . "\n";
$h = new \Holder();
$h->value = \fopen('php://memory', 'r');
echo \describe($h->get()) . "\n";
