---
source: crates/stir_syntax/tests/parser.rs
expression: "check_ok(\"function greet(name: String, mut times: Int = 1): String {\\n    var $out = \\\"\\\"\\n    while (times > 0) {\\n        $out = $out . \\\"Hello, ${name}! \\\"\\n        times -= 1\\n    }\\n    return $out\\n}\\n\",\nDialect :: Stir)"
---
