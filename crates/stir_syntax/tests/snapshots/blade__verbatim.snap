---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"a @verbatim {{ $a }} @if($b) @endverbatim {{ $c }}\")"
---
SOURCE_FILE
  INLINE_HTML_STMT
    INLINE_HTML "a "
  BLADE_DIRECTIVE
    BLADE_DIRECTIVE_NAME "@verbatim"
    INLINE_HTML " {{ $a }} @if($b) "
    BLADE_DIRECTIVE_NAME "@endverbatim"
  INLINE_HTML_STMT
    INLINE_HTML " "
  ECHO_TAG_STMT
    OPEN_TAG_WITH_ECHO "{{"
    VARIABLE_EXPR
      VARIABLE "$c"
  CLOSE_TAG "}}"
