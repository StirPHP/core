---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"@if ($a)@if ($b)@endif @else @if ($c)@endif @endif\")"
---
SOURCE_FILE
  IF_STMT
    IF_KW "@if"
    L_PAREN "("
    VARIABLE_EXPR
      VARIABLE "$a"
    R_PAREN ")"
    BLOCK
      IF_STMT
        IF_KW "@if"
        L_PAREN "("
        VARIABLE_EXPR
          VARIABLE "$b"
        R_PAREN ")"
        BLOCK
        ENDIF_KW "@endif"
      INLINE_HTML_STMT
        INLINE_HTML " "
    ELSE_CLAUSE
      ELSE_KW "@else"
      BLOCK
        INLINE_HTML_STMT
          INLINE_HTML " "
        IF_STMT
          IF_KW "@if"
          L_PAREN "("
          VARIABLE_EXPR
            VARIABLE "$c"
          R_PAREN ")"
          BLOCK
          ENDIF_KW "@endif"
        INLINE_HTML_STMT
          INLINE_HTML " "
    ENDIF_KW "@endif"
