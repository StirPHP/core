  FOREACH_STMT
    FOREACH_KW "@foreach"
    L_PAREN "("
    VARIABLE_EXPR
      VARIABLE "$a"
    AS_KW "AS"
    AMP "&"
    VARIABLE_EXPR
      VARIABLE "$b"
    R_PAREN ")"
    BLOCK
    ENDFOREACH_KW "@endforeach"
