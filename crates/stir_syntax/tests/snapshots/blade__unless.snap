---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"@unless ($a) a @else b @endunless\")"
---
SOURCE_FILE
  IF_STMT
    PREFIX_EXPR
      BANG "@unless"
      PAREN_EXPR
        L_PAREN "("
        VARIABLE_EXPR
          VARIABLE "$a"
        R_PAREN ")"
    BLOCK
      INLINE_HTML_STMT
        INLINE_HTML " a "
    ELSE_CLAUSE
      ELSE_KW "@else"
      BLOCK
        INLINE_HTML_STMT
          INLINE_HTML " b "
    ENDIF_KW "@endunless"
