---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"<?php $a = 1; ?>{{ $a }}<?= $a ?>@csrf\")"
---
SOURCE_FILE
  OPEN_TAG "<?php "
  EXPR_STMT
    ASSIGN_EXPR
      VARIABLE_EXPR
        VARIABLE "$a"
      EQ "="
      LITERAL
        INT_NUMBER "1"
    SEMI ";"
  CLOSE_TAG "?>"
  ECHO_TAG_STMT
    OPEN_TAG_WITH_ECHO "{{"
    VARIABLE_EXPR
      VARIABLE "$a"
  CLOSE_TAG "}}"
  ECHO_TAG_STMT
    OPEN_TAG_WITH_ECHO "<?="
    VARIABLE_EXPR
      VARIABLE "$a"
  CLOSE_TAG "?>"
  BLADE_DIRECTIVE
    BLADE_DIRECTIVE_NAME "@csrf"
