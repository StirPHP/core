---
source: crates/stir_syntax/tests/parser.rs
expression: "check_ok(\"<?php\\n\\nnamespace App;\\n\\nuse Foo\\\\Bar\\n\\nfunction greet(name: String): String {\\n    return \\\"Hello, ${name}\\\"\\n}\\n\\necho greet(\\\"world\\\")\\n\",\nDialect :: Stir)"
---
SOURCE_FILE
  OPEN_TAG "<?php"
  NAMESPACE_DECL
    NAMESPACE_KW "namespace"
    NAME_REF
      IDENT "App"
    SEMI ";"
  USE_DECL
    USE_KW "use"
    USE_CLAUSE
      NAME_REF
        NAME_QUALIFIED "Foo\\Bar"
  FUNCTION_DECL
    FUNCTION_KW "function"
    NAME
      IDENT "greet"
    PARAM_LIST
      L_PAREN "("
      PARAM
        NAME
          IDENT "name"
        COLON ":"
        NAMED_TYPE
          NAME_REF
            IDENT "String"
      R_PAREN ")"
    RETURN_TYPE
      COLON ":"
      NAMED_TYPE
        NAME_REF
          IDENT "String"
    BLOCK
      L_CURLY "{"
      RETURN_STMT
        RETURN_KW "return"
        INTERP_STRING
          DQUOTE "\""
          STRING_CONTENT "Hello, "
          INTERP_EXPR
            DOLLAR_CURLY_OPEN "${"
            NAME_EXPR
              NAME_REF
                IDENT "name"
            R_CURLY "}"
          DQUOTE "\""
      R_CURLY "}"
  ECHO_STMT
    ECHO_KW "echo"
    CALL_EXPR
      NAME_EXPR
        NAME_REF
          IDENT "greet"
      ARG_LIST
        L_PAREN "("
        ARG
          STRING_LITERAL
            STRING_DOUBLE "\"world\""
        R_PAREN ")"
