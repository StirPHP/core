---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"<?php if ($a): ?> a @else b @endif\")"
---
SOURCE_FILE
  OPEN_TAG "<?php "
  IF_STMT
    IF_KW "if"
    L_PAREN "("
    VARIABLE_EXPR
      VARIABLE "$a"
    R_PAREN ")"
    BLOCK
      COLON ":"
      CLOSE_TAG "?>"
      INLINE_HTML_STMT
        INLINE_HTML " a "
    ELSE_CLAUSE
      ELSE_KW "@else"
      BLOCK
        INLINE_HTML_STMT
          INLINE_HTML " b "
    ENDIF_KW "@endif"
