---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"a @php $a = 1; $b = 2 @endphp b\")"
---
SOURCE_FILE
  INLINE_HTML_STMT
    INLINE_HTML "a "
  OPEN_TAG "@php"
  EXPR_STMT
    ASSIGN_EXPR
      VARIABLE_EXPR
        VARIABLE "$a"
      EQ "="
      LITERAL
        INT_NUMBER "1"
    SEMI ";"
  EXPR_STMT
    ASSIGN_EXPR
      VARIABLE_EXPR
        VARIABLE "$b"
      EQ "="
      LITERAL
        INT_NUMBER "2"
  CLOSE_TAG "@endphp"
  INLINE_HTML_STMT
    INLINE_HTML " b"
