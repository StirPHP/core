    ISSET_EXPR
      ISSET_KW "@isset"
      ARG_LIST
        L_PAREN "("
        ARG
          VARIABLE_EXPR
            VARIABLE "$a"
        R_PAREN ")"
    BLOCK
      INLINE_HTML_STMT
        INLINE_HTML " "
