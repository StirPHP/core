---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"@forelse ($a as $b)@empty($b) a @endempty @empty c @endforelse\")"
---
SOURCE_FILE
  FOREACH_STMT
    FOREACH_KW "@forelse"
    L_PAREN "("
    VARIABLE_EXPR
      VARIABLE "$a"
    AS_KW "as"
    VARIABLE_EXPR
      VARIABLE "$b"
    R_PAREN ")"
    BLOCK
      IF_STMT
        EMPTY_EXPR
          EMPTY_KW "@empty"
          ARG_LIST
            L_PAREN "("
            ARG
              VARIABLE_EXPR
                VARIABLE "$b"
            R_PAREN ")"
        BLOCK
          INLINE_HTML_STMT
            INLINE_HTML " a "
        ENDIF_KW "@endempty"
      INLINE_HTML_STMT
        INLINE_HTML " "
    ENDFOREACH_KW "@empty"
  IF_STMT
    BLOCK
      INLINE_HTML_STMT
        INLINE_HTML " c "
    ENDIF_KW "@endforelse"
