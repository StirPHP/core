---
source: crates/stir_syntax/tests/blade.rs
expression: "check_ok(\"@empty($a) a @else b @endempty\")"
---
SOURCE_FILE
  IF_STMT
    EMPTY_EXPR
      EMPTY_KW "@empty"
      ARG_LIST
        L_PAREN "("
        ARG
          VARIABLE_EXPR
            VARIABLE "$a"
        R_PAREN ")"
    BLOCK
      INLINE_HTML_STMT
        INLINE_HTML " a "
    ELSE_CLAUSE
      ELSE_KW "@else"
      BLOCK
        INLINE_HTML_STMT
          INLINE_HTML " b "
    ENDIF_KW "@endempty"
