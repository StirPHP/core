---
source: crates/stir_syntax/tests/parser.rs
expression: "check_ok(\"val s = \\\"Hi ${name}, ${user->name}, ${f(\\\"a ${b}\\\")} $literal {$x}\\\"\\n\",\nDialect :: Stir)"
---
SOURCE_FILE
  VAL_DECL
    IDENT "val"
    NAME
      IDENT "s"
    EQ "="
    INTERP_STRING
      DQUOTE "\""
      STRING_CONTENT "Hi "
      INTERP_EXPR
        DOLLAR_CURLY_OPEN "${"
        NAME_EXPR
          NAME_REF
            IDENT "name"
        R_CURLY "}"
      STRING_CONTENT ", "
      INTERP_EXPR
        DOLLAR_CURLY_OPEN "${"
        PROPERTY_FETCH_EXPR
          NAME_EXPR
            NAME_REF
              IDENT "user"
          ARROW "->"
          NAME
            IDENT "name"
        R_CURLY "}"
      STRING_CONTENT ", "
      INTERP_EXPR
        DOLLAR_CURLY_OPEN "${"
        CALL_EXPR
          NAME_EXPR
            NAME_REF
              IDENT "f"
          ARG_LIST
            L_PAREN "("
            ARG
              INTERP_STRING
                DQUOTE "\""
                STRING_CONTENT "a "
                INTERP_EXPR
                  DOLLAR_CURLY_OPEN "${"
                  NAME_EXPR
                    NAME_REF
                      IDENT "b"
                  R_CURLY "}"
                DQUOTE "\""
            R_PAREN ")"
        R_CURLY "}"
      STRING_CONTENT " $literal {$x}"
      DQUOTE "\""
