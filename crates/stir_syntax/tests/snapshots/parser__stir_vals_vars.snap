---
source: crates/stir_syntax/tests/parser.rs
expression: "check_ok(\"val name: String = \\\"x\\\"\\nvar $count = 0\\n$count += 1\\nval total = $count * 2\\n\",\nDialect :: Stir)"
---
SOURCE_FILE
  VAL_DECL
    IDENT "val"
    NAME
      IDENT "name"
    COLON ":"
    NAMED_TYPE
      NAME_REF
        IDENT "String"
    EQ "="
    STRING_LITERAL
      STRING_DOUBLE "\"x\""
  VAR_DECL
    VAR_KW "var"
    VARIABLE "$count"
    EQ "="
    LITERAL
      INT_NUMBER "0"
  EXPR_STMT
    ASSIGN_EXPR
      VARIABLE_EXPR
        VARIABLE "$count"
      PLUS_EQ "+="
      LITERAL
        INT_NUMBER "1"
  VAL_DECL
    IDENT "val"
    NAME
      IDENT "total"
    EQ "="
    BIN_EXPR
      VARIABLE_EXPR
        VARIABLE "$count"
      STAR "*"
      LITERAL
        INT_NUMBER "2"
