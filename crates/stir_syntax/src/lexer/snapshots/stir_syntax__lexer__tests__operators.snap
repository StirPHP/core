---
source: crates/stir_syntax/src/lexer/tests.rs
expression: "dump(\"<?php $a ??= $b ?-> c; $a <=> $b; $a >>= 1; $a **= 2; $a !== $b; $a <> $b; #[Attr] ...\")"
---
OPEN_TAG "<?php "
VARIABLE "$a"
WHITESPACE " "
