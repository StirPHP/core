WHITESPACE " "
IDENT "c"
SEMI ";"
WHITESPACE " "
VARIABLE "$a"
WHITESPACE " "
SPACESHIP "<=>"
WHITESPACE " "
VARIABLE "$b"
SEMI ";"
WHITESPACE " "
VARIABLE "$a"
WHITESPACE " "
SHR_EQ ">>="
WHITESPACE " "
INT_NUMBER "1"
SEMI ";"
WHITESPACE " "
VARIABLE "$a"
WHITESPACE " "
POW_EQ "**="
WHITESPACE " "
INT_NUMBER "2"
SEMI ";"
WHITESPACE " "
VARIABLE "$a"
WHITESPACE " "
NEQ2 "!=="
WHITESPACE " "
VARIABLE "$b"
SEMI ";"
WHITESPACE " "
VARIABLE "$a"
WHITESPACE " "
NEQ "<>"
WHITESPACE " "
VARIABLE "$b"
SEMI ";"
WHITESPACE " "
ATTR_OPEN "#["
IDENT "Attr"
R_BRACK "]"
WHITESPACE " "
ELLIPSIS "..."
