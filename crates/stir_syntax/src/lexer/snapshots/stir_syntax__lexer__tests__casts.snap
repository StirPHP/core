---
source: crates/stir_syntax/src/lexer/tests.rs
expression: "dump(\"<?php (int)$a; ( string )$b; (BOOLEAN) $c; (array)$d; (Foo) $e;\")"
---
OPEN_TAG "<?php "
INT_CAST "(int)"
VARIABLE "$a"
SEMI ";"
WHITESPACE " "
STRING_CAST "( string )"
VARIABLE "$b"
SEMI ";"
WHITESPACE " "
BOOL_CAST "(BOOLEAN)"
WHITESPACE " "
VARIABLE "$c"
SEMI ";"
WHITESPACE " "
ARRAY_CAST "(array)"
VARIABLE "$d"
SEMI ";"
WHITESPACE " "
L_PAREN "("
IDENT "Foo"
R_PAREN ")"
WHITESPACE " "
VARIABLE "$e"
SEMI ";"
