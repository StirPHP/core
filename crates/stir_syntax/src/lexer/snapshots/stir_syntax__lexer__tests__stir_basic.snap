---
source: crates/stir_syntax/src/lexer/tests.rs
expression: "dump(\"val name: String = \\\"x\\\"\\nvar $count = 0\\n\", Dialect :: Stir)"
---
IDENT "val"
WHITESPACE " "
IDENT "name"
COLON ":"
WHITESPACE " "
IDENT "String"
WHITESPACE " "
EQ "="
WHITESPACE " "
STRING_DOUBLE "\"x\""
WHITESPACE "\n"
VAR_KW "var"
WHITESPACE " "
VARIABLE "$count"
WHITESPACE " "
EQ "="
WHITESPACE " "
INT_NUMBER "0"
WHITESPACE "\n"
