---
source: crates/stir_syntax/src/lexer/tests.rs
expression: "dump(r#\"<?php \"a $b c {$d->e['f']} ${g} $h[0] $i[k] $j[$l] $m->n $o[-1]\";\"#,\nDialect :: Php)"
---
OPEN_TAG "<?php "
DQUOTE "\""
STRING_CONTENT "a "
VARIABLE "$b"
STRING_CONTENT " c "
CURLY_OPEN "{"
VARIABLE "$d"
ARROW "->"
IDENT "e"
L_BRACK "["
STRING_SINGLE "'f'"
R_BRACK "]"
R_CURLY "}"
STRING_CONTENT " "
DOLLAR_CURLY_OPEN "${"
IDENT "g"
R_CURLY "}"
STRING_CONTENT " "
VARIABLE "$h"
L_BRACK "["
INT_NUMBER "0"
R_BRACK "]"
STRING_CONTENT " "
VARIABLE "$i"
L_BRACK "["
IDENT "k"
R_BRACK "]"
STRING_CONTENT " "
VARIABLE "$j"
L_BRACK "["
VARIABLE "$l"
R_BRACK "]"
STRING_CONTENT " "
VARIABLE "$m"
ARROW "->"
IDENT "n"
STRING_CONTENT " "
VARIABLE "$o"
L_BRACK "["
MINUS "-"
INT_NUMBER "1"
R_BRACK "]"
DQUOTE "\""
SEMI ";"
