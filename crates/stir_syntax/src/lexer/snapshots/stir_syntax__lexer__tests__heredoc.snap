---
source: crates/stir_syntax/src/lexer/tests.rs
expression: "dump(\"<?php $x = <<<EOT\\n  Hello $name\\n  {$a[1]}\\n  EOT;\\n\", Dialect :: Php)"
---
OPEN_TAG "<?php "
VARIABLE "$x"
WHITESPACE " "
EQ "="
WHITESPACE " "
HEREDOC_START "<<<EOT\n"
STRING_CONTENT "  Hello "
VARIABLE "$name"
STRING_CONTENT "\n  "
CURLY_OPEN "{"
VARIABLE "$a"
L_BRACK "["
INT_NUMBER "1"
R_BRACK "]"
R_CURLY "}"
STRING_CONTENT "\n"
HEREDOC_END "  EOT"
SEMI ";"
WHITESPACE "\n"
