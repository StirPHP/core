=== output
<?php
class A {
    /** @var list<int> */
    private array $items = [];

    /** @return list<int> */
    public function getItems(): array
    {
        return $this->items;
    }

    /** @param list<int> $items */
    public function setItems(array $items): void
    {
        $this->items = $items;
    }
}
