=== output
<?php
class A {
    private int $before = 0;
    /** @var list<string> */
    private array $names;
    private string|false $label;

    /**
     * @param list<string> $names
     * @param string|false $label
     */
    public function __construct(array $names, string|false $label)
    {
        $this->names = $names;
        $this->label = $label;
    }
}
