=== action: Convert promoted parameters to properties
=== php: 8.1
=== input
<?php
class A {
    public function __construct‸(private int $a = 1, protected readonly string $b = 'x', bool $c = false)
    {
        echo $c;
    }
}
=== output
<?php
class A {
    private int $a;
    protected readonly string $b;

    public function __construct(int $a = 1, string $b = 'x', bool $c = false)
    {
        $this->a = $a;
        $this->b = $b;
        echo $c;
    }
}
