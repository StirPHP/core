=== output
<?php
function f(array $a): void {
    $n = 0;
    foreach ($a as $x) {
        echo $n;
        $n = extracted($n, $x);
    }
}

function extracted($n, $x): int|float
{
    $n = $n + $x;
    return $n;
}
