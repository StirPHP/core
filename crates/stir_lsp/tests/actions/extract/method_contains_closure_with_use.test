=== output
<?php
class A {
    public function run(int $a): callable {
        $f = self::extracted($a);
        return $f;
    }

    /** @return Closure(int): int */
    private static function extracted(int $a): Closure
    {
        $f = function (int $b) use ($a) {
            $c = $b + $a;
            return $c;
        };
        return $f;
    }
}
