function loop_declares(): int {
    var $total: int = 0
    for (var $i = 0; $i < 3; $i++) {
        $total += 1
    }
    return $total
}

function undeclared_in_for(): Unit {
    for ($j = 0; false; ) { // error: SPHP0017
        echo 1
    }
}

function ternary_across_lines(b: bool): int {
    val x = b
        ? 1
        : 2
    return x
}

function elseif_expression(a: int): int = if (a > 1) 1 elseif (a > 0) 2 else 3

val union_param = { a: int|string -> 1 }

function order_php_strings(a: string, b: string): bool = a < b
function spaceship(a: string, b: string): int = a <=> b
function literal_vs_php(c: string): bool = "a" <= c
function not_orderable(a: array, b: string): bool = a < b // error: SPHP0013

function array_key_fits(a: array): bool {
    foreach (a as $k => $v) {
        return array_key_exists($k, a)
    }
    return false
}

class R1 {
    function a(): int = 1
    public var $p: int = 1
}
class R2 {
    function a(): int = 2
    public var $p: int = 2
    function only(): int = 3
}
function shared_members(x: R1|R2): int = x->a() + x->p
function not_shared(x: R1|R2): int = x->only() // error: SPHP0009

// @sphp-ignore-next-line
val ignored_next: String = 1
val ignored_same: String = 1 // @sphp-ignore
val not_ignored: String = 1 // error: SPHP0005
