function casts(s: String, a: array<string>, v: unknown): Unit {
    val x = s as String // warning: SPHP0033
    val y = a as array // warning: SPHP0033
    val z = v as string
    val w = v as array
    val maybe = s as? String
    echo strval(s) // warning: SPHP0033
    val n: Int = 1
    val m = intval(n) // warning: SPHP0033
}

function php_to_stir(s: string): String = strval(s)

function string_contexts(n: int, s: string, f: Float, b: Bool, u: unknown): Unit {
    echo "a" . n
    echo n . "a"
    echo "a" . f
    echo "a" . s
    var $out: string = ""
    $out .= n
    $out .= f
    echo "a" . b // error: SPHP0015
    echo "a" . u // error: SPHP0015
    $out .= b // error: SPHP0015
    echo "a" . strval(n) // warning: SPHP0033
    echo strval(n) // warning: SPHP0033
    echo "x${strval(s)}" // warning: SPHP0033
    $out .= strval(n) // warning: SPHP0033
    echo "a" . strval(b)
    take_string(strval(n))
}

function take_string(s: string): Unit {}
