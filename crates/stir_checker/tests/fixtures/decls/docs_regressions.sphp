// Found while checking the documentation's examples.

// a `val` property can't be assigned through implicit `this`
class Counter {
    var $count: Int = 0
    val step: Int = 2

    function tick(): Unit {
        $count += step
    }

    function reset(): Unit {
        step = 1 // error: SPHP0010
    }
}

// `override` needs something to override
open class Shape {
    open function area(): Float = 0.0
}
class Square : Shape() {
    override function area(): Float = 1.0
    override function size(): Int = 1 // error: SPHP0031
}

// a class without a constructor takes its type arguments from the expected type
class Stack<T> {
    private var $items: MutableList<T> = mutableListOf()

    function push(item: T): Unit {
        $items->add(item)
    }
}
val ints: Stack<Int> = new Stack()
ints->push(1)
ints->push("two") // error: SPHP0005
