namespace App

sealed interface Result<out T>
data class Ok<T>(val value: T) : Result<T>
data class Err(val msg: String) : Result<Nothing>

function show(r: Result<Int>): String = when (r) {
    is Ok -> "ok ${r->value}"
    is Err -> "err ${r->msg}"
}

function partial(r: Result<Int>): String = when (r) { // error: SPHP0005
    is Ok -> "ok"
}

typealias Status = "active" | "banned" | "pending"

function label(s: Status): String = when (s) {
    "active" -> "A"
    "banned", "pending" -> "B"
}

function label2(s: Status): String = when (s) { // error: SPHP0005
    "active" -> "A"
}

function sign(x: Int): String = when {
    x > 0 -> "pos"
    x < 0 -> "neg"
    else -> "zero"
}

function boolWhen(b: Bool): Int = when (b) {
    true -> 1
    false -> 0
}

function stmtWhen(x: Int): Unit {
    when (x) {
        1 -> echo "one"
    }
}
