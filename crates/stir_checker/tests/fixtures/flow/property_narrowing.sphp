class Node {
    public var $next: Node? = null
    public var $name: string? = null
    public val fixed: string? = null

    function length(): int {
        if ($this->name !== null) {
            return strlen($this->name)
        }
        return 0
    }

    function after_guard(): int {
        if ($this->name === null) {
            return 0
        }
        return strlen($this->name)
    }

    function initialized_in_branch(): int {
        if ($this->name === null) {
            $this->name = "default"
        }
        return strlen($this->name)
    }

    function calls_dont_reset(): int {
        if ($this->name === null) {
            return 0
        }
        $this->length()
        return strlen($this->name)
    }

    function assignment_resets(): int {
        if ($this->name === null) {
            return 0
        }
        $this->name = null
        return strlen($this->name) // error: SPHP0005
    }

    function can_still_assign_null(): Unit {
        if ($this->name !== null) {
            $this->name = null
        }
    }

    function not_narrowed_without_a_check(): int = strlen($this->name) // error: SPHP0005

    function after_the_if_it_is_unknown_again(): int {
        if ($this->name !== null) {
            echo strlen($this->name)
        }
        return strlen($this->name) // error: SPHP0005
    }

    function chains(): int {
        val n = $this->next
        if (n !== null && n->name !== null) {
            return strlen(n->name)
        }
        return 0
    }

    function deep(): int {
        if ($this->next !== null && $this->next->name !== null) {
            return strlen($this->next->name)
        }
        return 0
    }

    function reassigning_the_base_forgets(other: Node): int {
        var $n = other
        if ($n->name === null) {
            return 0
        }
        $n = new Node()
        return strlen($n->name) // error: SPHP0005
    }

    function loops_that_assign_reset(xs: array<int>): int {
        if ($this->name === null) {
            return 0
        }
        foreach (xs as $x) {
            echo strlen($this->name) // error: SPHP0005
            $this->name = null
        }
        return 0
    }

    function loops_that_dont_keep_it(xs: array<int>): int {
        if ($this->name === null) {
            return 0
        }
        foreach (xs as $x) {
            echo strlen($this->name)
        }
        return strlen($this->name)
    }
}

function maybe(): string? = null

function var_narrowed_after_branch(): int {
    var $t = maybe()
    if ($t === null) {
        $t = maybe()
        if ($t === null) {
            return 0
        }
    }
    return strlen($t)
}

function assigned_in_both_branches(b: bool): int {
    var $t: string? = null
    if (b) {
        $t = "a"
    } else {
        $t = "b"
    }
    return strlen($t)
}

function assigned_on_one_path(b: bool): int {
    var $t: string? = maybe()
    if (b) {
        $t = "a"
    }
    return strlen($t) // error: SPHP0005
}

function elseif_paths(n: int): int {
    var $t: string? = null
    if (n > 1) {
        $t = "a"
    } else if (n > 0) {
        $t = null
    } else {
        return 0
    }
    return strlen($t) // error: SPHP0005
}

class Attrs {
    public var $attrs: array? = null
    public var $error: string? = null
    const OVERFLOW = "overflow"

    function initialize_if_empty(): bool {
        if (empty($this->attrs)) {
            $this->attrs = []
        }
        return array_key_exists("x", $this->attrs)
    }

    function not_empty_narrows(s: string|false|null): int {
        if (!empty(s)) {
            return strlen(s)
        }
        return 0
    }

    function reset_then_compare(): bool {
        $this->error = null
        $this->run()
        return self::OVERFLOW === $this->error
    }

    function run(): Unit {}
}

function is_bool_false_branch(s: array|bool): array {
    if (is_bool(s)) {
        return []
    }
    return s
}

function is_callable_narrows(c: callable?): Unit {
    if (is_callable(c)) {
        call_user_func(c)
    }
}

class Errors {
    public var $error: string? = null
    const OVERFLOW = "overflow"

    function checked_null_then_compare(): bool {
        if ($this->error !== null) {
            return false
        }
        $this->run()
        return self::OVERFLOW === $this->error
    }

    function run(): Unit {}
}
