function maybe(): string? = null

function narrowing_survives_loops(xs: array<int>): int {
    var $s: string? = maybe()
    if ($s === null) {
        return 0
    }
    foreach (xs as $x) {
        echo strlen($s) + $x
    }
    return strlen($s)
}

function reassigned_in_loop_loses_it(xs: array<int>): int {
    var $s: string? = maybe()
    if ($s === null) {
        return 0
    }
    foreach (xs as $x) {
        echo strlen($s) // error: SPHP0005
        $s = maybe()
    }
    return strlen($s) // error: SPHP0005
}

function append_php_string(p: string): string {
    var $d: string = ""
    $d .= p
    return $d
}

function string_offset(s: string): string = s[0] ?? ""

function isset_narrows(s: string?): int {
    if (isset(s)) {
        return strlen(s)
    }
    return 0
}

class D {
    public var $a: array<string, int>? = null
    function has(k: string): bool = isset($this->a[k])
}

function jumps(n: int): int {
    if (n > 2) {
        goto done
    }
    echo n
    done:
    return n
}

function gen(): Generator<int, string> {
    yield "a"
    return
}

function gen2(): Iterator<int, string> {
    yield "a"
}
