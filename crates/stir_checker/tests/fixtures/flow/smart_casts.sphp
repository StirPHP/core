namespace App

class User(val name: String)
class Admin(val name: String, val level: Int)

function describe(x: Int | String | null): String {
    if (x is Int) {
        return "int ${x + 1}"
    }
    if (x == null) {
        return "null"
    }
    return x->uppercase()
}

function early(u: User?): String {
    if (u == null) return "none"
    return u->name
}

function andChain(u: User?): Bool = u != null && u->name == "a"
function orChain(u: User?): Bool = u == null || u->name == "a"

function notIs(x: Int | String): Int {
    if (x !is Int) {
        return x->length()
    }
    return x
}

function reassigned(): Unit {
    var $u: User? = new User("a")
    echo $u->name
    $u = null
    echo $u->name // error: SPHP0012
}

function elseNarrow(u: User?): String {
    if (u != null) {
        return u->name
    } else {
        return "none"
    }
}

function loopWiden(): Unit {
    var $u: User? = null
    while (true) {
        if ($u != null) {
            echo $u->name
        }
        $u = new User("x")
    }
}

function instance(x: User | Admin): Int {
    if (x instanceof Admin) {
        return x->level
    }
    return 0
}

function bad(x: Int | String): Int {
    return x // error: SPHP0005
}
