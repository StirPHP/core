namespace App

interface Shape { function area(): Float }
class Square(val side: Float) : Shape {
    function area(): Float = side * side
}

function <T of Shape> biggest(a: T, b: T): T = if (a->area() > b->area()) a else b

val sq = biggest(new Square(1.0), new Square(2.0))
val bad = biggest(1, 2) // error: SPHP0028

class Holder<T of Shape>(val item: T)
val h: Holder<Int>? = null // error: SPHP0028
val h2 = new Holder(1) // error: SPHP0028
