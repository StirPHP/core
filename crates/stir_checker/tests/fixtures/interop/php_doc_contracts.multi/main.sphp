function asserted(v: Failure|string): string {
    if (is_failure(v)) {
        return v->message()
    }
    return v
}

function asserted_false(v: Failure|string): string {
    if (is_success(v)) {
        return v
    }
    return v->message()
}

function not_narrowed_without_the_call(v: Failure|string): string = v // error: SPHP0005

function conditional_return(a: string): int = positive(a)

function shapes(): Unit {
    register_thing(["apply" => "strlen", "name" => "a"])
    register_thing(["name" => "a"])
    register_thing(["name" => 1]) // error: SPHP0005
    register_thing(["apply" => "strlen"]) // error: SPHP0005
}

function callable_strings(): Unit {
    takes_callable("strlen")
}
