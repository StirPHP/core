function bare_arrays_are_arrays(a: array, b: array): array {
    val merged = array_merge(a, b)
    foreach (merged as $k => $v) {
        echo strlen($v) // error: SPHP0005
    }
    echo count(bare())
    echo merged["k"] + 1 // error: SPHP0015
    takes_names(merged)
    val parts = unpack("N", "abcd")
    if (parts === false) {
        return []
    }
    echo count(parts)
    return merged
}

class Sub : PhpEntry {
    function add(x: int): Unit {
        $this->items[] = x
        $this->names[] = "x"
    }
}

function php_property_offset(e: PhpEntry): Unit {
    e->attrs["x"] = 1
    e->names[] = "y"
}

function still_read_only(): Unit {
    var $l = listOf(1)
    $l[] = 1 // error: SPHP0010
}

function declared_stays_php(): Unit {
    var $m: array<string, string|int|null> = ["a" => null]
    $m["a"] = 1
    $m["b"] = "x"
}

function literal_inference(n: int, s: string): Int {
    var $i = 0
    $i = n
    $i += n
    var $t = ""
    $t = s
    $t .= s
    var $u = ""
    $u .= s
    var $safe = 1
    $safe = 2
    return $safe
}

function php_family_sticks(n: int): Int {
    var $i = 0
    $i = n
    return $i // error: SPHP0005
}

function not_any_type(s: string): Unit {
    var $i = 0
    $i = s // error: SPHP0005
}

function array_functions_keep_types(m: Map<String, int>, a: array<string, int>, s: string): string {
    val keys = array_keys(a)
    foreach (keys as $k) {
        echo strlen($k)
    }
    foreach (array_values(a) as $v) {
        echo $v + 1
    }
    foreach (array_filter(a) as $k => $v) {
        echo strlen($k) + $v
    }
    return str_replace(array_keys(["a" => "b"]), array_values(["a" => "b"]), s)
}

function explode_is_indexable(s: string): string = trim(explode(",", s)[0])
