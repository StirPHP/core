// The generated runtime (a `.php` image of the stdlib) is in the project, as
// when an editor opens build/stir-runtime.php: the stdlib still wins.
class Registry {
    private static var $instances: MutableMap<String, Registry> = mutableMapOf()

    static function put(name: String, r: Registry): Unit {
        self::$instances[name] = r
    }
}

val names: MutableList<String> = mutableListOf("a")
