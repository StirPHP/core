function keys_and_values(m: array<string, string>, l: array<int>): Unit {
    foreach (m as $k => $v) {
        echo strlen($k) + strlen($v)
    }
    foreach (l as $i) {
        echo $i + 1
    }
    echo strlen(l) // error: SPHP0005
}

function after_literal_check(): String {
    val d = doc_only()
    if (d === "") {
        return ""
    }
    return "${d}!"
}

class Holder {
    private var $map: array<string, string> = []
    function reset(m: array<string, bool> = [], l: array<int> = []): Unit {
        $map = []
    }
}

function php_offset_may_be_missing(m: array<string, bool>): bool = m["k"] ?? false

function known_non_null(s: String): String = s ?? "" // warning: SPHP0021

function any_value(v: string|int|array|null): string {
    if (v !is string || v === "") {
        return ""
    }
    return v
}

function both_sides_narrow(v: string?): int {
    if (v !== null && strlen(v) > 0) {
        return strlen(v)
    }
    return 0
}

function union_default(a: array<string, string>|Holder = []): Unit {}

function replaced(s: string, l: array<string>): string {
    val r = str_replace("a", "b", s)
    val p = preg_replace("/a/", "b", s) ?: ""
    return r . p
}

function replaced_array(l: array<string>): string = str_replace("a", "b", l) // error: SPHP0005

typealias AnyValue = string|int|float|bool|array|object|null

function takes_any(v: AnyValue): Unit {}

function bare_arrays(a: array, m: array<string, array<int>>): Unit {
    takes_any(a["k"])
    wants_mixed(a)
    foreach (m["k"] ?? [] as $x) {
        echo $x
    }
    echo strtr("a", ["a" => "b"])
    echo strtr("a", "a", "b")
}

function php_property_takes_php_values(key: string, n: int): Unit {
    val entry = new Php_Entry()
    entry->singular = key
    entry->singular = n // error: SPHP0005
}

function iterate_union(): Unit {
    foreach (array_keys(["a" => 1]) as $k) {
        echo $k
    }
}

function union_cast(v: string|int|array|null): Unit {
    val c = v as string|int
    echo strlen(c as string)
}

function false_stays_in_unions(p: string): string {
    val found = realpath(p)
    if (found === false) {
        return ""
    }
    return found
}
