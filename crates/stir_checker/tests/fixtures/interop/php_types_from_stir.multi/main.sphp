function keys_and_values(m: array<string, string>, l: array<int>): Unit {
    foreach (m as $k => $v) {
        echo strlen($k) + strlen($v)
    }
    foreach (l as $i) {
        echo $i + 1
    }
    echo strlen(l) // error: SPHP0005
}

function after_literal_check(): String {
    val d = doc_only()
    if (d === "") {
        return ""
    }
    return "${d}!"
}

class Holder {
    private var $map: array<string, string> = []
    function reset(m: array<string, bool> = [], l: array<int> = []): Unit {
        $map = []
    }
}

function php_offset_may_be_missing(m: array<string, bool>): bool = m["k"] ?? false

function known_non_null(s: String): String = s ?? "" // warning: SPHP0021
