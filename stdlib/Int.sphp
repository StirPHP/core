namespace Stir

// Extension functions on `Int` (a PHP int: 64-bit signed on 64-bit builds).
// PHP turns overflowing int arithmetic into float; functions here that can overflow
// throw \ArithmeticError instead of returning a Float in disguise.

/** Returns `value` if it is an Int; throws \ArithmeticError if it is a Float (an int operation overflowed into float). */
function intOrOverflow(value: Int | Float): Int = if (value is Int) value else throw new \ArithmeticError("Integer overflow.")

/** Returns the decimal representation, e.g. "-42". */
function Int.toString(): String = strval(this)

/** Returns the value as a Float (may lose precision above 2^53). */
function Int.toFloat(): Float = floatval(this)

/** Returns the absolute value; throws \ArithmeticError for PHP_INT_MIN. */
function Int.abs(): Int = intOrOverflow(abs(this))

/** Returns this value, or `minimumValue` if this is smaller. */
function Int.coerceAtLeast(minimumValue: Int): Int = max(this, minimumValue)

/** Returns this value, or `maximumValue` if this is larger. */
function Int.coerceAtMost(maximumValue: Int): Int = min(this, maximumValue)

/** Clamps this value into [minimumValue, maximumValue]; throws \InvalidArgumentException if the range is empty. */
function Int.coerceIn(minimumValue: Int, maximumValue: Int): Int =
    if (minimumValue > maximumValue) throw new \InvalidArgumentException("Cannot coerce value to an empty range: maximum ${maximumValue} is less than minimum ${minimumValue}.")
    else min(max(this, minimumValue), maximumValue)

/** Returns true if the value is divisible by 2. */
function Int.isEven(): Bool = this % 2 === 0

/** Returns true if the value is not divisible by 2 (works for negatives). */
function Int.isOdd(): Bool = this % 2 !== 0

/** Raises this value to a non-negative `exponent`; throws \InvalidArgumentException for a negative exponent and \ArithmeticError on overflow. */
function Int.pow(exponent: Int): Int =
    if (exponent < 0) throw new \InvalidArgumentException("Negative exponent ${exponent}; use Float.pow.")
    else intOrOverflow(this ** exponent)

/** Returns -1, 0 or 1 according to the sign of the value. */
function Int.sign(): Int = this <=> 0

/** Returns the smaller of this value and `other`. */
function Int.min(other: Int): Int = min(this, other)

/** Returns the larger of this value and `other`. */
function Int.max(other: Int): Int = max(this, other)

/** Compares with `other`: -1, 0 or 1. */
function Int.compareTo(other: Int): Int = this <=> other

/** Integer division truncating toward zero; throws \DivisionByZeroError for 0 and \ArithmeticError for PHP_INT_MIN / -1. */
function Int.div(other: Int): Int = intdiv(this, other)

/** Remainder of truncating division (sign follows this value); throws \DivisionByZeroError for 0. */
function Int.rem(other: Int): Int = this % other

/** Floor modulus (sign follows `other`), e.g. (-1)->mod(3) == 2; throws \DivisionByZeroError for 0. */
function Int.mod(other: Int): Int = ((this % other) + other) % other

/** Returns [this, ..., end] ascending, or [] if `end` < this. */
function Int.rangeTo(end: Int): List<Int> = if (end < this) [] else range(this, end)

/** Returns [this, ..., end - 1] ascending, or [] if `end` <= this. */
function Int.until(end: Int): List<Int> = if (end <= this) [] else range(this, end - 1)

/** Returns [this, ..., to] descending, or [] if `to` > this. */
function Int.downTo(to: Int): List<Int> = if (to > this) [] else range(this, to)
