namespace Stir

// Extension functions on the read-only `List<T>`. At runtime a List is a PHP list
// (an array with keys 0..n-1). Every function returning a List re-indexes its result
// (array_values) so that invariant holds. Element comparisons are strict (===).
//
// Callbacks are wrapped in a lambda whenever PHP would pass extra arguments (array_any,
// array_all, array_find, array_find_key and array_walk pass the key too), because PHP
// internal functions given as callables reject surplus arguments.

/** A value paired with its index, as produced by `withIndex()`. */
record IndexedValue<T> {
    index: Int
    value: T
}

/** Returns the number of elements. */
function <T> List<T>.size(): Int = count(this)

/** Returns true if the list has no elements. */
function <T> List<T>.isEmpty(): Bool = this === []

/** Returns true if the list has at least one element. */
function <T> List<T>.isNotEmpty(): Bool = this !== []

/** Returns the indices [0, ..., size - 1]. */
function <T> List<T>.indices(): List<Int> = array_keys(this) as List<Int>

/** Returns the index of the last element, or -1 for an empty list. */
function <T> List<T>.lastIndex(): Int = count(this) - 1

/** Returns the element at `index`; throws \OutOfBoundsException if out of range. */
function <T> List<T>.get(index: Int): T =
    if (index >= 0 && index < count(this)) this[index]
    else throw new \OutOfBoundsException("Index ${index} out of bounds for length ${count(this)}.")

/** Returns the element at `index`, or null if out of range. */
function <T> List<T>.getOrNull(index: Int): T? = if (index >= 0 && index < count(this)) this[index] else null

/** Returns the element at `index`, or `defaultValue(index)` if out of range. */
function <T> List<T>.getOrElse(index: Int, defaultValue: (Int) -> T): T =
    if (index >= 0 && index < count(this)) this[index] else defaultValue(index)

/** Returns the first element; throws \OutOfBoundsException if the list is empty. */
function <T> List<T>.first(): T = if (this === []) throw new \OutOfBoundsException("List is empty.") else this[0]

/** Returns the first element, or null if the list is empty. */
function <T> List<T>.firstOrNull(): T? = if (this === []) null else this[0]

/** Returns the last element; throws \OutOfBoundsException if the list is empty. */
function <T> List<T>.last(): T = if (this === []) throw new \OutOfBoundsException("List is empty.") else this[count(this) - 1]

/** Returns the last element, or null if the list is empty. */
function <T> List<T>.lastOrNull(): T? = if (this === []) null else this[count(this) - 1]

/** Returns a uniformly random element; throws \OutOfBoundsException if the list is empty. */
function <T> List<T>.random(): T = if (this === []) throw new \OutOfBoundsException("List is empty.") else this[random_int(0, count(this) - 1)]

/** Returns a uniformly random element, or null if the list is empty. */
function <T> List<T>.randomOrNull(): T? = if (this === []) null else this[random_int(0, count(this) - 1)]

/** Returns true if the list contains `element` (strict comparison). */
function <T> List<T>.contains(element: T): Bool = in_array(element, this, true)

/** Returns true if every element of `elements` is in this list (strict comparison). */
function <T> List<T>.containsAll(elements: List<T>): Bool = array_all(elements, { element: T, index: Int -> in_array(element, this, true) })

/** Returns the index of the first occurrence of `element`, or null if absent. */
function <T> List<T>.indexOf(element: T): Int? = nullIfFalse(array_search(element, this, true) as (Int | false))

/** Returns the index of the last occurrence of `element`, or null if absent. */
function <T> List<T>.lastIndexOf(element: T): Int? = nullIfFalse(array_search(element, array_reverse(this, true), true) as (Int | false))

/** Returns the index of the first element matching `predicate`, or null if none. */
function <T> List<T>.indexOfFirst(predicate: (T) -> Bool): Int? = array_find_key(this, { element: T, index: Int -> predicate(element) }) as Int?

/** Returns the index of the last element matching `predicate`, or null if none. */
function <T> List<T>.indexOfLast(predicate: (T) -> Bool): Int? = array_find_key(array_reverse(this, true), { element: T, index: Int -> predicate(element) }) as Int?

/** Returns a list of `transform` applied to each element. */
function <T, R> List<T>.map(transform: (T) -> R): List<R> = array_map(transform, this) as List<R>

/** Returns a list of `transform(index, element)` for each element. */
function <T, R> List<T>.mapIndexed(transform: (Int, T) -> R): List<R> = array_map(transform, array_keys(this), this) as List<R>

/** Returns the non-null results of `transform` applied to each element. */
function <T, R> List<T>.mapNotNull(transform: (T) -> R?): List<R> = array_values(array_filter(array_map(transform, this), { result: R? -> result !== null })) as List<R>

/** Returns the elements matching `predicate`. */
function <T> List<T>.filter(predicate: (T) -> Bool): List<T> = array_values(array_filter(this, { element: T -> predicate(element) })) as List<T>

/** Returns the elements for which `predicate(index, element)` holds. */
function <T> List<T>.filterIndexed(predicate: (Int, T) -> Bool): List<T> =
    array_values(array_filter(this, { element: T, index: Int -> predicate(index, element) }, ARRAY_FILTER_USE_BOTH)) as List<T>

/** Returns the elements not matching `predicate`. */
function <T> List<T>.filterNot(predicate: (T) -> Bool): List<T> = array_values(array_filter(this, { element: T -> !predicate(element) })) as List<T>

/** Returns the non-null elements. */
function <T> List<T? >.filterNotNull(): List<T> = array_values(array_filter(this, { element: T? -> element !== null })) as List<T>

/**
 * Calls `action` on each element in order.
 * Block body: array_walk returns Bool, which must not leak out of a Unit function.
 */
function <T> List<T>.forEach(action: (T) -> Unit): Unit {
    array_walk(this, { element: T -> action(element) })
}

/**
 * Calls `action(index, element)` on each element in order.
 * Block body: array_walk returns Bool, which must not leak out of a Unit function.
 */
function <T> List<T>.forEachIndexed(action: (Int, T) -> Unit): Unit {
    array_walk(this, { element: T, index: Int -> action(index, element) })
}

/** Returns true if at least one element matches `predicate` (false for an empty list). */
function <T> List<T>.any(predicate: (T) -> Bool): Bool = array_any(this, { element: T, index: Int -> predicate(element) })

/** Returns true if every element matches `predicate` (true for an empty list). */
function <T> List<T>.all(predicate: (T) -> Bool): Bool = array_all(this, { element: T, index: Int -> predicate(element) })

/** Returns true if no element matches `predicate` (true for an empty list). */
function <T> List<T>.none(predicate: (T) -> Bool): Bool = !this->any(predicate)

/** Returns the number of elements matching `predicate`. */
function <T> List<T>.count(predicate: (T) -> Bool): Int = count(array_filter(this, { element: T -> predicate(element) }))

/** Returns the first element matching `predicate`, or null if none. */
function <T> List<T>.find(predicate: (T) -> Bool): T? = array_find(this, { element: T, index: Int -> predicate(element) }) as T?

/** Returns the last element matching `predicate`, or null if none. */
function <T> List<T>.findLast(predicate: (T) -> Bool): T? = array_find(array_reverse(this), { element: T, index: Int -> predicate(element) }) as T?

/** Accumulates from `initial`, applying `operation(accumulator, element)` left to right. */
function <T, R> List<T>.fold(initial: R, operation: (R, T) -> R): R = array_reduce(this, { accumulator: R, element: T -> operation(accumulator, element) }, initial) as R

/** Accumulates from the first element, applying `operation` left to right; throws \LengthException if the list is empty. */
function <T> List<T>.reduce(operation: (T, T) -> T): T =
    if (this === []) throw new \LengthException("Empty list can't be reduced.")
    else array_reduce(array_slice(this, 1), operation, this[0]) as T

/** Returns the sum of the elements (0 for an empty list); throws \ArithmeticError on overflow. */
function List<Int>.sum(): Int = intOrOverflow(array_sum(this))

/** Returns the sum of the elements (0.0 for an empty list). */
function List<Float>.sum(): Float = floatval(array_sum(this))

/** Returns the sum of `selector` over the elements; throws \ArithmeticError on overflow. */
function <T> List<T>.sumOf(selector: (T) -> Int): Int = intOrOverflow(array_sum(array_map(selector, this)) as (Int | Float))

/** Returns the arithmetic mean, or NaN for an empty list. */
function <T of Int | Float> List<T>.average(): Float = fdiv(array_sum(this), count(this))

/** Returns the smallest element, or null if the list is empty (strings compare by code point). */
function <T of Int | Float | String> List<T>.minOrNull(): T? =
    this->sorted()->firstOrNull()

/** Returns the largest element, or null if the list is empty (strings compare by code point). */
function <T of Int | Float | String> List<T>.maxOrNull(): T? =
    this->sortedDescending()->firstOrNull()

/** Returns the first element with the smallest `selector` value, or null if empty (stable sort; `selector` may run several times per element). */
function <T, R of Int | Float | String> List<T>.minByOrNull(selector: (T) -> R): T? = this->sortedBy(selector)->firstOrNull()

/** Returns the first element with the largest `selector` value, or null if empty (stable sort; `selector` may run several times per element). */
function <T, R of Int | Float | String> List<T>.maxByOrNull(selector: (T) -> R): T? = this->sortedByDescending(selector)->firstOrNull()

/** Joins `prefix`, the elements (stringified by PHP or by `transform`) separated by `separator`, and `postfix`. */
function <T> List<T>.joinToString(separator: String = ", ", prefix: String = "", postfix: String = "", transform: ((T) -> String)? = null): String =
    prefix . implode(separator, if (transform === null) this else array_map(transform, this)) . postfix

/** Returns the elements in reverse order. */
function <T> List<T>.reversed(): List<T> = array_reverse(this) as List<T>

/**
 * Returns the elements sorted by `comparator` (negative, zero or positive); the sort is stable.
 * Block body: usort sorts in place by reference, so a local copy is required.
 */
function <T> List<T>.sortedWith(comparator: (T, T) -> Int): List<T> {
    var $copy = this
    usort($copy, comparator)
    return $copy
}

/** Returns the elements in ascending order (strings by code point, never as numeric strings). */
function <T of Int | Float | String> List<T>.sorted(): List<T> = this->sortedWith({ a, b -> compareValues(a, b) })

/** Returns the elements in descending order (strings by code point). */
function <T of Int | Float | String> List<T>.sortedDescending(): List<T> = this->sortedWith({ a, b -> compareValues(b, a) })

/** Returns the elements sorted ascending by `selector` (stable; `selector` may run several times per element). */
function <T, R of Int | Float | String> List<T>.sortedBy(selector: (T) -> R): List<T> =
    this->sortedWith({ a, b -> compareValues(selector(a), selector(b)) })

/** Returns the elements sorted descending by `selector` (stable; `selector` may run several times per element). */
function <T, R of Int | Float | String> List<T>.sortedByDescending(selector: (T) -> R): List<T> =
    this->sortedWith({ a, b -> compareValues(selector(b), selector(a)) })

/**
 * Returns the elements in random order.
 * Block body: shuffle works in place by reference, so a local copy is required.
 */
function <T> List<T>.shuffled(): List<T> {
    var $copy = this
    shuffle($copy)
    return $copy
}

/** Returns the elements without duplicates, keeping first occurrences; equality is by serialize() (so 1 and "1" differ; objects compare by value; closures throw). */
function <T> List<T>.distinct(): List<T> = array_values(array_intersect_key(this, array_unique(array_map({ element: T -> serialize(element) }, this)))) as List<T>

/** Returns the elements whose `selector` value was not seen before, keeping first occurrences; keys compare by serialize(). */
function <T, K> List<T>.distinctBy(selector: (T) -> K): List<T> =
    array_values(array_intersect_key(this, array_unique(array_map({ element: T -> serialize(selector(element)) }, this)))) as List<T>

/** Returns the first `n` elements (all if shorter; negative `n` is treated as 0). */
function <T> List<T>.take(n: Int): List<T> = array_slice(this, 0, n->coerceAtLeast(0)) as List<T>

/** Returns all but the first `n` elements ([] if shorter; negative `n` is treated as 0). */
function <T> List<T>.drop(n: Int): List<T> = array_slice(this, n->coerceAtLeast(0)) as List<T>

/** Returns the last `n` elements (all if shorter; non-positive `n` gives []). */
function <T> List<T>.takeLast(n: Int): List<T> = if (n <= 0) [] else array_slice(this, -n) as List<T>

/** Returns all but the last `n` elements ([] if shorter; negative `n` is treated as 0). */
function <T> List<T>.dropLast(n: Int): List<T> = array_slice(this, 0, (count(this) - n->coerceAtLeast(0))->coerceAtLeast(0)) as List<T>

/** Returns the longest prefix whose elements all match `predicate`. */
function <T> List<T>.takeWhile(predicate: (T) -> Bool): List<T> =
    array_slice(this, 0, this->indexOfFirst({ element: T -> !predicate(element) }) ?: count(this)) as List<T>

/** Returns the elements after the longest prefix matching `predicate`. */
function <T> List<T>.dropWhile(predicate: (T) -> Bool): List<T> =
    array_slice(this, this->indexOfFirst({ element: T -> !predicate(element) }) ?: count(this)) as List<T>

/** Returns the elements in [fromIndex, toIndex); out-of-range bounds are clamped. */
function <T> List<T>.subList(fromIndex: Int, toIndex: Int): List<T> = array_slice(this, fromIndex->coerceAtLeast(0), (toIndex - fromIndex->coerceAtLeast(0))->coerceAtLeast(0)) as List<T>

/** Returns this list followed by `elements`. */
function <T> List<T>.plus(elements: List<T>): List<T> = array_merge(this, elements) as List<T>

/** Returns this list with `element` appended. */
function <T> List<T>.plusElement(element: T): List<T> = [...this, element]

/** Returns this list without any element that occurs in `elements` (strict comparison). */
function <T> List<T>.minus(elements: List<T>): List<T> = array_values(array_filter(this, { element: T -> !in_array(element, elements, true) })) as List<T>

/** Returns this list without any occurrence of `element` (strict comparison). */
function <T> List<T>.minusElement(element: T): List<T> = array_values(array_filter(this, { other: T -> other !== element })) as List<T>

/** Splits the list into consecutive chunks of `size` (the last may be shorter); throws \ValueError if `size` < 1. */
function <T> List<T>.chunked(size: Int): List<List<T>> = array_chunk(this, size) as List<List<T>>

/** Pairs up elements with the same index; the result is as long as the shorter list. */
function <T, R> List<T>.zip(other: List<R>): List<Pair<T, R>> =
    array_map(
        { a: T, b: R -> Pair { first = a, second = b } },
        array_slice(this, 0, count(this)->coerceAtMost(count(other))),
        array_slice(other, 0, count(this)->coerceAtMost(count(other))),
    ) as List<Pair<T, R>>

/** Returns a pair of (elements matching `predicate`, elements not matching it); `predicate` runs twice per element. */
function <T> List<T>.partition(predicate: (T) -> Bool): Pair<List<T>, List<T>> =
    Pair { first = this->filter(predicate), second = this->filterNot(predicate) }

/** Concatenates the lists returned by `transform` for each element. */
function <T, R> List<T>.flatMap(transform: (T) -> List<R>): List<R> = array_merge(...array_map(transform, this)) as List<R>

/** Concatenates the inner lists. */
function <T> List<List<T>>.flatten(): List<T> = array_merge(...this) as List<T>

/**
 * Groups the elements by `keySelector`, preserving element order inside each group and first-seen key order.
 * Block body: building the groups needs a mutable accumulator; there is no single PHP builtin for it.
 * Groups live in a list addressed through `$slots` (key -> group index), so each append is O(1)
 * and no write goes through a possibly-missing map entry.
 */
function <T, K of Int | String> List<T>.groupBy(keySelector: (T) -> K): Map<K, List<T>> {
    var $slots: MutableMap<K, Int> = []
    var $groups: MutableList<MutableList<T>> = []
    var $i = 0
    while ($i < count(this)) {
        val key = keySelector(this[$i])
        if (!array_key_exists(key, $slots)) {
            $slots[key] = count($groups)
            $groups[] = mutableListOf()
        }
        $groups[$slots[key]][] = this[$i]
        $i++
    }
    return array_combine(array_keys($slots), $groups) as Map<K, List<T>>
}

/** Returns a map from `keySelector(element)` to element; on duplicate keys the last element wins. */
function <T, K of Int | String> List<T>.associateBy(keySelector: (T) -> K): Map<K, T> = array_combine(array_map(keySelector, this), this) as Map<K, T>

/** Returns a map from each element to `valueSelector(element)`; on duplicates the last value wins. */
function <K of Int | String, V> List<K>.associateWith(valueSelector: (K) -> V): Map<K, V> = array_combine(this, array_map(valueSelector, this)) as Map<K, V>

/** Returns a map built from the pairs returned by `transform`; on duplicate keys the last pair wins. Relies on Pair lowering to array{first, second}. */
function <T, K of Int | String, V> List<T>.associate(transform: (T) -> Pair<K, V>): Map<K, V> = array_column(array_map(transform, this), "second", "first") as Map<K, V>

/** Returns each element paired with its index. */
function <T> List<T>.withIndex(): List<IndexedValue<T>> = array_map({ i: Int, v: T -> IndexedValue { index = i, value = v } }, array_keys(this), this) as List<IndexedValue<T>>

/** Returns a mutable copy of the list (PHP arrays are copied by value). */
function <T> List<T>.toMutableList(): MutableList<T> = this as MutableList<T>

/** Returns a read-only copy of the list. */
function <T> List<T>.toList(): List<T> = this
