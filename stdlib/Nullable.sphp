namespace Stir

// Helpers for nullable values, PHP interop, and scope functions on any type.

/** Converts PHP's `false` "not found" sentinel (strpos, array_search, ...) into null; any other value is returned unchanged. */
function <T> nullIfFalse(value: T | false): T? = if (value === false) null else value

/** Calls `block` with this value and returns its result (use with `?->let` to run only on non-null). */
function <T, R> T.let(block: (T) -> R): R = block(this)

/**
 * Calls `block` with this value and returns this value.
 * Block body: the call must run for its side effect before `this` is returned; there is no sequencing expression.
 */
function <T> T.also(block: (T) -> Unit): T {
    block(this)
    return this
}

/** Returns this value if it satisfies `predicate`, otherwise null. */
function <T> T.takeIf(predicate: (T) -> Bool): T? = if (predicate(this)) this else null

/** Returns this value if it does not satisfy `predicate`, otherwise null. */
function <T> T.takeUnless(predicate: (T) -> Bool): T? = if (predicate(this)) null else this

/** Calls `block` and returns its result. */
function <R> run(block: () -> R): R = block()

/** Returns this string, or "" if it is null. */
function String?.orEmpty(): String = this ?: ""

/** Returns this list, or an empty list if it is null. */
function <T> List<T>?.orEmpty(): List<T> = this ?: []

/** Returns this map, or an empty map if it is null. */
function <K, V> Map<K, V>?.orEmpty(): Map<K, V> = this ?: []

/** Returns true if this string is null or "". */
function String?.isNullOrEmpty(): Bool = this === null || this === ""

/** Returns true if this string is null, empty, or only (Unicode) whitespace. */
function String?.isNullOrBlank(): Bool = this === null || preg_match('/\A\s*\z/u', this) === 1

/** Returns true if this list is null or has no elements. */
function <T> List<T>?.isNullOrEmpty(): Bool = this === null || this === []

/** Returns true if this map is null or has no entries. */
function <K, V> Map<K, V>?.isNullOrEmpty(): Bool = this === null || this === []
