namespace Stir

// Mutating extension functions on `MutableList<T>`. All read-only operations come from
// List.sphp, since MutableList<T> is a subtype of List<T>.
//
// BY-REFERENCE RECEIVER ASSUMPTION
// PHP arrays are values, so a function that mutates its receiver only works if the
// receiver is passed by reference. Every function in this file assumes `this` is bound
// by reference: emitted as `function name(array &$this_, ...)` and called as
// `name($list, ...)`, or, when inlined, operating directly on the caller's variable.
// The receiver at a call site must therefore be an assignable place (a `var $x`, a
// mutable property, an array element), never a temporary. Assigning to `this` here
// means assigning to the caller's variable. Indices stay 0..n-1 after every operation.
//
// Functions whose PHP builtin returns a value we do not want (e.g. array_push returns the
// new count) still use an expression body; a Unit return type discards that value.

// TODO(stir): needs by-reference receiver
/** Appends `element` to the end of the list. */
function <T> MutableList<T>.add(element: T): Unit = array_push(this, element)

// TODO(stir): needs by-reference receiver
/** Inserts `element` at `index`, shifting later elements; an index past the end appends (negative counts from the end, PHP array_splice). */
function <T> MutableList<T>.addAt(index: Int, element: T): Unit = array_splice(this, index, 0, [element])

// TODO(stir): needs by-reference receiver
/** Appends all `elements` to the end of the list. */
function <T> MutableList<T>.addAll(elements: List<T>): Unit = array_push(this, ...elements)

// TODO(stir): needs by-reference receiver
/** Replaces the element at `index`; throws \OutOfBoundsException if out of range. */
function <T> MutableList<T>.set(index: Int, element: T): Unit =
    if (index >= 0 && index < count(this)) this[index] = element
    else throw new \OutOfBoundsException("Index ${index} out of bounds for length ${count(this)}.")

// TODO(stir): needs by-reference receiver
/** Removes and returns the element at `index`; throws \OutOfBoundsException if out of range. */
function <T> MutableList<T>.removeAt(index: Int): T =
    if (index >= 0 && index < count(this)) (array_splice(this, index, 1) as List<T>)[0]
    else throw new \OutOfBoundsException("Index ${index} out of bounds for length ${count(this)}.")

// TODO(stir): needs by-reference receiver
/** Removes the first occurrence of `element` (strict comparison); returns true if one was removed. */
function <T> MutableList<T>.remove(element: T): Bool =
    in_array(element, this, true) && array_splice(this, array_search(element, this, true) as Int, 1) !== []

// TODO(stir): needs by-reference receiver
/** Removes and returns the first element; throws \OutOfBoundsException if the list is empty. */
function <T> MutableList<T>.removeFirst(): T = if (this === []) throw new \OutOfBoundsException("List is empty.") else array_shift(this) as T

// TODO(stir): needs by-reference receiver
/** Removes and returns the last element; throws \OutOfBoundsException if the list is empty. */
function <T> MutableList<T>.removeLast(): T = if (this === []) throw new \OutOfBoundsException("List is empty.") else array_pop(this) as T

// TODO(stir): needs by-reference receiver
/** Removes and returns the first element, or returns null if the list is empty. */
function <T> MutableList<T>.removeFirstOrNull(): T? = array_shift(this) as T?

// TODO(stir): needs by-reference receiver
/** Removes and returns the last element, or returns null if the list is empty. */
function <T> MutableList<T>.removeLastOrNull(): T? = array_pop(this) as T?

// TODO(stir): needs by-reference receiver
/** Removes every element matching `predicate`. */
function <T> MutableList<T>.removeAll(predicate: (T) -> Bool): Unit = this = array_values(array_filter(this, { element: T -> !predicate(element) })) as MutableList<T>

// TODO(stir): needs by-reference receiver
/** Keeps only the elements matching `predicate`. */
function <T> MutableList<T>.retainAll(predicate: (T) -> Bool): Unit = this = array_values(array_filter(this, { element: T -> predicate(element) })) as MutableList<T>

// TODO(stir): needs by-reference receiver
/** Removes all elements. */
function <T> MutableList<T>.clear(): Unit = this = []

// TODO(stir): needs by-reference receiver
/** Sorts the list in place, ascending (strings by code point, never as numeric strings); stable. */
function <T of Int | Float | String> MutableList<T>.sort(): Unit = usort(this, { a: T, b: T -> compareValues(a, b) })

// TODO(stir): needs by-reference receiver
/** Sorts the list in place, descending (strings by code point); stable. */
function <T of Int | Float | String> MutableList<T>.sortDescending(): Unit = usort(this, { a: T, b: T -> compareValues(b, a) })

// TODO(stir): needs by-reference receiver
/** Sorts the list in place, ascending by `selector`; stable. */
function <T, R of Int | Float | String> MutableList<T>.sortBy(selector: (T) -> R): Unit =
    usort(this, { a: T, b: T -> compareValues(selector(a), selector(b)) })

// TODO(stir): needs by-reference receiver
/** Sorts the list in place, descending by `selector`; stable. */
function <T, R of Int | Float | String> MutableList<T>.sortByDescending(selector: (T) -> R): Unit =
    usort(this, { a: T, b: T -> compareValues(selector(b), selector(a)) })

// TODO(stir): needs by-reference receiver
/** Sorts the list in place with `comparator` (negative, zero or positive); stable. */
function <T> MutableList<T>.sortWith(comparator: (T, T) -> Int): Unit = usort(this, comparator)

// TODO(stir): needs by-reference receiver
/** Reverses the list in place. */
function <T> MutableList<T>.reverse(): Unit = this = array_reverse(this) as MutableList<T>

// TODO(stir): needs by-reference receiver
/** Shuffles the list in place. */
function <T> MutableList<T>.shuffle(): Unit = shuffle(this)
