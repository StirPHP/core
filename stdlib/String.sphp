namespace Stir

// Extension functions on `String`. At runtime a String is a PHP string holding UTF-8;
// every index and length below counts Unicode code points (mb_* functions), not bytes.

/** Returns the number of Unicode code points in the string. */
function String.length(): Int = mb_strlen(this)

/** Returns true if the string has no characters. */
function String.isEmpty(): Bool = this === ""

/** Returns true if the string has at least one character. */
function String.isNotEmpty(): Bool = this !== ""

/** Returns true if the string is empty or contains only (Unicode) whitespace. */
function String.isBlank(): Bool = preg_match('/\A\s*\z/u', this) === 1

/** Returns true if the string contains at least one non-whitespace character. */
function String.isNotBlank(): Bool = preg_match('/\A\s*\z/u', this) !== 1

/** Returns `defaultValue()` if the string is empty, otherwise the string itself. */
function String.ifEmpty(defaultValue: () -> String): String = if (this === "") defaultValue() else this

/** Returns `defaultValue()` if the string is blank, otherwise the string itself. */
function String.ifBlank(defaultValue: () -> String): String = if (preg_match('/\A\s*\z/u', this) === 1) defaultValue() else this

/** Returns the string converted to upper case (Unicode-aware). */
function String.uppercase(): String = mb_strtoupper(this)

/** Returns the string converted to lower case (Unicode-aware). */
function String.lowercase(): String = mb_strtolower(this)

/** Returns the string with its first character converted to title case; "" stays "". */
function String.capitalize(): String = mb_ucfirst(this)

/** Returns the string with its first character converted to lower case; "" stays "". */
function String.decapitalize(): String = mb_lcfirst(this)

/** Returns the string with leading and trailing (Unicode) whitespace removed. */
function String.trim(): String = mb_trim(this)

/** Returns the string with leading (Unicode) whitespace removed. */
function String.trimStart(): String = mb_ltrim(this)

/** Returns the string with trailing (Unicode) whitespace removed. */
function String.trimEnd(): String = mb_rtrim(this)

/** Returns true if the string starts with `prefix`; `ignoreCase` compares Unicode case-folded forms. */
function String.startsWith(prefix: String, ignoreCase: Bool = false): Bool =
    if (ignoreCase) str_starts_with(mb_convert_case(this, MB_CASE_FOLD), mb_convert_case(prefix, MB_CASE_FOLD))
    else str_starts_with(this, prefix)

/** Returns true if the string ends with `suffix`; `ignoreCase` compares Unicode case-folded forms. */
function String.endsWith(suffix: String, ignoreCase: Bool = false): Bool =
    if (ignoreCase) str_ends_with(mb_convert_case(this, MB_CASE_FOLD), mb_convert_case(suffix, MB_CASE_FOLD))
    else str_ends_with(this, suffix)

/** Returns true if `other` occurs in the string (an empty `other` always matches). */
function String.contains(other: String, ignoreCase: Bool = false): Bool =
    if (ignoreCase) mb_stripos(this, other) !== false
    else str_contains(this, other)

/** Returns the code-point index of the first occurrence of `other` at or after `startIndex`, or null if absent; throws \ValueError if `startIndex` is past the end. */
function String.indexOf(other: String, startIndex: Int = 0): Int? = nullIfFalse(mb_strpos(this, other, startIndex))

/** Returns the code-point index of the last occurrence of `other`, or null if absent ("" matches at `length()`). */
function String.lastIndexOf(other: String): Int? = nullIfFalse(mb_strrpos(this, other))

/** Returns the characters in [startIndex, endIndex) (endIndex defaults to the end); throws \OutOfBoundsException if the range is invalid. */
function String.substring(startIndex: Int, endIndex: Int? = null): String =
    if (startIndex < 0 || startIndex > mb_strlen(this) || (endIndex !== null && (endIndex < startIndex || endIndex > mb_strlen(this))))
        throw new \OutOfBoundsException("Invalid substring range [${startIndex}, ${endIndex}) for length ${mb_strlen(this)}.")
    else mb_substr(this, startIndex, if (endIndex === null) null else endIndex - startIndex)

/** Returns the part of the string before the first occurrence of `delimiter`, or the whole string if absent. */
function String.substringBefore(delimiter: String): String =
    if (str_contains(this, delimiter)) strstr(this, delimiter, true) else this

/** Returns the part of the string after the first occurrence of `delimiter`, or the whole string if absent. */
function String.substringAfter(delimiter: String): String =
    if (str_contains(this, delimiter)) substr(strstr(this, delimiter), strlen(delimiter)) else this

/** Returns the first `n` characters (the whole string if shorter; negative `n` is treated as 0). */
function String.take(n: Int): String = mb_substr(this, 0, max(0, n))

/** Returns the string without its first `n` characters ("" if shorter; negative `n` is treated as 0). */
function String.drop(n: Int): String = mb_substr(this, max(0, n))

/** Returns the last `n` characters (the whole string if shorter; non-positive `n` gives ""). */
function String.takeLast(n: Int): String = if (n <= 0) "" else mb_substr(this, -n)

/** Returns the string without its last `n` characters ("" if shorter; negative `n` is treated as 0). */
function String.dropLast(n: Int): String = mb_substr(this, 0, max(0, mb_strlen(this) - max(0, n)))

/** Returns the string with every occurrence of `oldValue` replaced by `newValue`; an empty `oldValue` leaves the string unchanged (PHP str_replace). */
function String.replace(oldValue: String, newValue: String): String = str_replace(oldValue, newValue, this)

/** Returns the string with every match of the PCRE `pattern` (with delimiters, e.g. '/\d+/u') replaced by `replacement`. */
function String.replaceRegex(pattern: String, replacement: String): String = preg_replace(pattern, replacement, this)

/** Returns true if the whole-or-partial PCRE `pattern` (with delimiters) matches the string. */
function String.matches(pattern: String): Bool = preg_match(pattern, this) === 1

/** Splits the string around `separator` (at most `limit` parts when `limit` > 0); throws \ValueError if `separator` is empty. */
function String.split(separator: String, limit: Int = 0): List<String> =
    explode(separator, this, if (limit > 0) limit else PHP_INT_MAX)

/** Splits the string into lines on "\r\n", "\r" or "\n"; "" gives [""]. */
function String.lines(): List<String> = explode("\n", str_replace(["\r\n", "\r"], "\n", this))

/** Returns the string repeated `n` times; throws \ValueError if `n` is negative. */
function String.repeat(n: Int): String = str_repeat(this, n)

/** Returns the string with its code points in reverse order (combining sequences are not kept together). */
function String.reversed(): String = implode("", array_reverse(mb_str_split(this)))

/** Pads the start of the string with `padChar` up to `length` characters; throws \ValueError if `padChar` is empty. */
function String.padStart(length: Int, padChar: String = " "): String = mb_str_pad(this, length, padChar, STR_PAD_LEFT)

/** Pads the end of the string with `padChar` up to `length` characters; throws \ValueError if `padChar` is empty. */
function String.padEnd(length: Int, padChar: String = " "): String = mb_str_pad(this, length, padChar, STR_PAD_RIGHT)

/** Parses the string as a base-10 Int (optional sign, digits only, no whitespace); null if malformed or out of range. */
function String.toIntOrNull(): Int? =
    if (preg_match('/\A[+-]?[0-9]+\z/', this) !== 1) null
    else filter_var(preg_replace('/\A([+-]?)0+(?=[0-9])/', '$1', this), FILTER_VALIDATE_INT, FILTER_NULL_ON_FAILURE)

/** Parses the string as a base-10 Int; throws \InvalidArgumentException if malformed or out of range. */
function String.toInt(): Int = this->toIntOrNull() ?: throw new \InvalidArgumentException("Invalid Int format: '${this}'.")

/** Parses a decimal float such as "1", "-2.5", ".5" or "1e3"; null if malformed (no whitespace, NaN or Infinity accepted). */
function String.toFloatOrNull(): Float? =
    if (preg_match('/\A[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?\z/', this) === 1) floatval(this) else null

/** Parses a decimal float; throws \InvalidArgumentException if malformed. */
function String.toFloat(): Float = this->toFloatOrNull() ?: throw new \InvalidArgumentException("Invalid Float format: '${this}'.")

/** Returns true only for "true" in any letter case, false for anything else. */
function String.toBool(): Bool = strtolower(this) === "true"

/** Returns the character (a one-code-point string) at `index`; throws \OutOfBoundsException if out of range. */
function String.get(index: Int): String =
    if (index >= 0 && index < mb_strlen(this)) mb_substr(this, index, 1)
    else throw new \OutOfBoundsException("String index out of range: ${index}.")

/** Returns the character at `index`, or null if out of range. */
function String.getOrNull(index: Int): String? =
    if (index >= 0 && index < mb_strlen(this)) mb_substr(this, index, 1) else null

/** Returns the characters (one-code-point strings) of the string; "" gives []. */
function String.chars(): List<String> = mb_str_split(this)

/** Returns the string without `prefix` if it starts with it, otherwise unchanged. */
function String.removePrefix(prefix: String): String =
    if (str_starts_with(this, prefix)) substr(this, strlen(prefix)) else this

/** Returns the string without `suffix` if it ends with it, otherwise unchanged (an empty suffix is a no-op). */
function String.removeSuffix(suffix: String): String =
    if (suffix !== "" && str_ends_with(this, suffix)) substr(this, 0, strlen(this) - strlen(suffix)) else this

/** Returns true if both strings are equal after Unicode case folding. */
function String.equalsIgnoreCase(other: String): Bool =
    mb_convert_case(this, MB_CASE_FOLD) === mb_convert_case(other, MB_CASE_FOLD)

/** Compares by code point (byte order of UTF-8): negative, zero or positive; never numeric-string comparison. */
function String.compareTo(other: String): Int = strcmp(this, other) <=> 0
