{
  "name": "stirphp",
  "displayName": "StirPHP",
  "description": "Type checking, completion and navigation for PHP and Laravel's Blade templates, from the StirPHP language server.",
  "version": "0.2.0",
  "publisher": "stirphp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, custom rules and PHPStan never run, and `stirphp.server.path` and `stirphp.phpstan.path` from the workspace are ignored.",
      "restrictedConfigurations": [
        "stirphp.server.path",
        "stirphp.phpstan.path",
        "stirphp.phpstan.configuration"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "blade",
        "aliases": [
          "Blade",
          "blade"
        ],
        "extensions": [
          ".blade.php"
        ],
        "configuration": "./grammars/blade.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blade",
        "scopeName": "text.html.blade.stirphp",
        "path": "./grammars/blade.tmLanguage.json",
        "embeddedLanguages": {
          "source.php": "php",
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "configuration": {
      "title": "StirPHP",
      "properties": {
        "stirphp.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `stirphp` binary to run (started as `stirphp lsp`): a path, or a command on the `PATH`. Leave empty to let the extension download and update `stirphp` itself."
        },
        "stirphp.server.channel": {
          "type": "string",
          "enum": [
            "stable",
            "nightly"
          ],
          "enumDescriptions": [
            "The latest release.",
            "Built from every commit on main; may be broken."
          ],
          "default": "stable",
          "markdownDescription": "Which builds of `stirphp` the extension downloads (when `stirphp.server.path` is empty)."
        },
        "stirphp.server.autoUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Look for a newer `stirphp` every few hours and install it (when `stirphp.server.path` is empty). **StirPHP: Check for Updates** checks at any time."
        },
        "stirphp.phpstan.enable": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "If the project has PHPStan's configuration and PHPStan among its Composer packages, unless `parameters.stirphp.phpstan` says otherwise.",
            "Run it, and say so if it can't be found.",
            "Never run it."
          ],
          "default": "auto",
          "markdownDescription": "Run the project's PHPStan in the background on save and show what it reports with StirPHP's diagnostics. You're asked first, since it runs code from the project, and it never runs in an untrusted workspace."
        },
        "stirphp.phpstan.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `phpstan` to run: a path, relative to the project, or a command on the `PATH`. Leave empty to use the project's `vendor/bin/phpstan`. A global `phpstan` is only used if named here."
        },
        "stirphp.phpstan.configuration": {
          "type": "string",
          "default": "",
          "markdownDescription": "PHPStan's configuration, relative to the project. Leave empty for the one PHPStan finds by itself."
        },
        "stirphp.phpstan.level": {
          "type": "string",
          "default": "",
          "markdownDescription": "The level, a number or `max`, over the one in PHPStan's configuration. Leave empty to use that."
        },
        "stirphp.phpstan.memoryLimit": {
          "type": "string",
          "default": "",
          "markdownDescription": "PHP's memory limit for each PHPStan process, as in `--memory-limit`: `1G`, or `-1` for none. Leave empty for `2G`."
        },
        "stirphp.phpstan.timeout": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "markdownDescription": "How many seconds a run gets. `0` means 600."
        },
        "stirphp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "How much of the communication with the language server to log: `verbose` adds message contents. It's logged once the log level of the **StirPHP** output channel is Trace."
        }
      }
    },
    "commands": [
      {
        "command": "stirphp.restartServer",
        "title": "Restart Language Server",
        "category": "StirPHP"
      },
      {
        "command": "stirphp.checkForUpdates",
        "title": "Check for Updates",
        "category": "StirPHP"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "php",
        "scopes": {
          "namespace": [
            "entity.name.type.namespace.php"
          ],
          "type": [
            "keyword.other.type.php"
          ],
          "typeParameter": [
            "support.class.php"
          ],
          "class": [
            "support.class.php"
          ],
          "class.declaration": [
            "entity.name.type.class.php"
          ],
          "class.defaultLibrary": [
            "support.class.builtin.php"
          ],
          "interface": [
            "support.class.php"
          ],
          "interface.declaration": [
            "entity.name.type.interface.php"
          ],
          "enum": [
            "support.class.php"
          ],
          "enum.declaration": [
            "entity.name.type.enum.php"
          ],
          "enumMember": [
            "constant.enum.php"
          ],
          "function": [
            "entity.name.function.php"
          ],
          "function.defaultLibrary": [
            "support.function.basic_functions.php"
          ],
          "method": [
            "entity.name.function.php"
          ],
          "parameter": [
            "variable.other.php"
          ],
          "variable": [
            "variable.other.php"
          ],
          "variable.readonly": [
            "constant.other.php"
          ],
          "property": [
            "variable.other.property.php"
          ],
          "property.static": [
            "variable.other.class.php"
          ],
          "property.readonly.static": [
            "constant.other.class.php"
          ]
        }
      },
      {
        "language": "blade",
        "scopes": {
          "namespace": [
            "entity.name.type.namespace.php"
          ],
          "type": [
            "keyword.other.type.php"
          ],
          "typeParameter": [
            "support.class.php"
          ],
          "class": [
            "support.class.php"
          ],
          "class.declaration": [
            "entity.name.type.class.php"
          ],
          "class.defaultLibrary": [
            "support.class.builtin.php"
          ],
          "interface": [
            "support.class.php"
          ],
          "interface.declaration": [
            "entity.name.type.interface.php"
          ],
          "enum": [
            "support.class.php"
          ],
          "enum.declaration": [
            "entity.name.type.enum.php"
          ],
          "enumMember": [
            "constant.enum.php"
          ],
          "function": [
            "entity.name.function.php"
          ],
          "function.defaultLibrary": [
            "support.function.basic_functions.php"
          ],
          "method": [
            "entity.name.function.php"
          ],
          "parameter": [
            "variable.other.php"
          ],
          "variable": [
            "variable.other.php"
          ],
          "variable.readonly": [
            "constant.other.php"
          ],
          "property": [
            "variable.other.property.php"
          ],
          "property.static": [
            "variable.other.class.php"
          ],
          "property.readonly.static": [
            "constant.other.class.php"
          ]
        }
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "package": "vsce package --allow-missing-repository",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tar": "7.5.22",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
