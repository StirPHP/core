{
  "name": "stirphp",
  "displayName": "StirPHP",
  "description": "Type checking, completion and navigation for plain PHP, from the StirPHP language server.",
  "version": "0.1.21",
  "publisher": "stirphp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:php"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, custom rules never run, and `stirphp.server.path` from the workspace is ignored.",
      "restrictedConfigurations": ["stirphp.server.path"]
    }
  },
  "contributes": {
    "configuration": {
      "title": "StirPHP",
      "properties": {
        "stirphp.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `stirphp` binary to run (started as `stirphp lsp`): a path, or a command on the `PATH`. Leave empty to let the extension download and update `stirphp` itself."
        },
        "stirphp.server.channel": {
          "type": "string",
          "enum": [
            "stable",
            "nightly"
          ],
          "enumDescriptions": [
            "The latest release.",
            "Built from every commit on main; may be broken."
          ],
          "default": "stable",
          "markdownDescription": "Which builds of `stirphp` the extension downloads (when `stirphp.server.path` is empty)."
        },
        "stirphp.server.autoUpdate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Look for a newer `stirphp` every few hours and install it (when `stirphp.server.path` is empty). **StirPHP: Check for Updates** checks at any time."
        },
        "stirphp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "How much of the communication with the language server to log: `verbose` adds message contents. It's logged once the log level of the **StirPHP** output channel is Trace."
        }
      }
    },
    "commands": [
      {
        "command": "stirphp.restartServer",
        "title": "Restart Language Server",
        "category": "StirPHP"
      },
      {
        "command": "stirphp.checkForUpdates",
        "title": "Check for Updates",
        "category": "StirPHP"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "php",
        "scopes": {
          "namespace": [
            "entity.name.type.namespace.php"
          ],
          "type": [
            "keyword.other.type.php"
          ],
          "typeParameter": [
            "support.class.php"
          ],
          "class": [
            "support.class.php"
          ],
          "class.declaration": [
            "entity.name.type.class.php"
          ],
          "class.defaultLibrary": [
            "support.class.builtin.php"
          ],
          "interface": [
            "support.class.php"
          ],
          "interface.declaration": [
            "entity.name.type.interface.php"
          ],
          "enum": [
            "support.class.php"
          ],
          "enum.declaration": [
            "entity.name.type.enum.php"
          ],
          "enumMember": [
            "constant.enum.php"
          ],
          "function": [
            "entity.name.function.php"
          ],
          "function.defaultLibrary": [
            "support.function.basic_functions.php"
          ],
          "method": [
            "entity.name.function.php"
          ],
          "parameter": [
            "variable.other.php"
          ],
          "variable": [
            "variable.other.php"
          ],
          "variable.readonly": [
            "constant.other.php"
          ],
          "property": [
            "variable.other.property.php"
          ],
          "property.static": [
            "variable.other.class.php"
          ],
          "property.readonly.static": [
            "constant.other.class.php"
          ]
        }
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tar": "7.5.22",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
